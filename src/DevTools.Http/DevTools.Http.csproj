<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-targeted: the app this library serves is Windows-only. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DevTools.Http</RootNamespace>
    <AssemblyName>DevTools.Http</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevTools.Core\DevTools.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The statistics helpers are implementation detail, but they are the part most worth
         asserting directly. Opening them to the test assembly beats widening the public API. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DevTools.Http.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
