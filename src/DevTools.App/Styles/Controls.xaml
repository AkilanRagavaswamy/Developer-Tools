<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A translucent panel used for tool cards, option groups and result surfaces. -->
    <Style x:Key="DevToolsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DevToolsCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DevToolsCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource DevToolsCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource DevToolsCardPadding}" />
    </Style>

    <!-- The small icon buttons in every editor toolbar. -->
    <Style x:Key="DevToolsToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!--
        The title bar's own buttons. Sized to the system caption buttons sitting next to them —
        46 x 32 effective pixels, which is what Windows draws minimise, maximise and close at —
        because a 40 px button beside a 46 px one reads as a misalignment rather than a choice.
        Every size is here rather than on each button: the favourite button had drifted to 30.
    -->
    <Style
        x:Key="DevToolsCaptionButtonStyle"
        BasedOn="{StaticResource DevToolsToolbarButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="DevToolsToolbarToggleStyle" TargetType="ToggleButton">
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- The grey capitals over a grid of editable rows. -->
    <Style x:Key="DevToolsColumnHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="40" />
    </Style>

    <!-- Section heading inside a tool page. -->
    <Style x:Key="DevToolsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="DevToolsCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Read-only monospace surface used for computed results. -->
    <Style x:Key="DevToolsResultTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DevToolsMonospaceFont}" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Label/value rows in result panes: consistent width keeps values aligned. -->
    <Style x:Key="DevToolsFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DevToolsFieldValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DevToolsMonospaceFont}" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A card whose content reaches the edges: previews, report lists, anything with its own header. -->
    <Style x:Key="DevToolsPreviewCardStyle" TargetType="Border" BasedOn="{StaticResource DevToolsCardStyle}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Tool card on the dashboard. -->
    <Style x:Key="DevToolsToolCardStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource DevToolsCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DevToolsCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource DevToolsCardCornerRadius}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>


    <!--
        The options bar. One per tool, one row, at the top of the page. Fixing the height and
        the inner padding here is what stops six tools drifting apart a pixel at a time.
    -->
    <Style x:Key="DevToolsOptionsBarStyle" TargetType="Border" BasedOn="{StaticResource DevToolsCardStyle}">
        <Setter Property="Height" Value="52" />
        <Setter Property="Padding" Value="{StaticResource DevToolsOptionsBarPadding}" />
    </Style>

    <!-- The grey word in front of a control: "Action", "Indent", "Arrays". -->
    <Style x:Key="DevToolsOptionLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Everything sitting on an options bar is 30 px tall, whatever kind of control it is. -->
    <Style x:Key="DevToolsInlineComboStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="{StaticResource DevToolsControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource DevToolsControlHeight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="11,0,0,0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="DevToolsInlineTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource DevToolsControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource DevToolsControlHeight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="DevToolsInlineButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource DevToolsControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource DevToolsControlHeight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="{StaticResource DevToolsInlinePadding}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="DevToolsInlineAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Height" Value="{StaticResource DevToolsControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource DevToolsControlHeight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="{StaticResource DevToolsInlinePadding}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="DevToolsInlineDropDownStyle" TargetType="DropDownButton">
        <Setter Property="Height" Value="{StaticResource DevToolsControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource DevToolsControlHeight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="{StaticResource DevToolsInlinePadding}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="DevToolsInlineCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!--
        The count on an overflow button. Collapsing rare options behind "More" hides them; the
        badge is what stops them being forgotten, because a glance still says two are on.
    -->
    <Style x:Key="DevToolsCountBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DevToolsAccentBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DevToolsCountBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource DevToolsOnAccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A thin rule between two groups on an options bar. -->
    <Style x:Key="DevToolsOptionsSeparatorStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Background" Value="{ThemeResource DevToolsCardBorderBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
