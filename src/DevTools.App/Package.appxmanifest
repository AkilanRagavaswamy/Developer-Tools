<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
		 xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
		 xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
		 xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
		 IgnorableNamespaces="uap uap3 rescap">

	<Identity Name="AkilanRagavaswamy.ForgeKitRk-DeveloperToolkit" Publisher="CN=4FEF7FAB-6AD4-4C46-88A8-05AFF705DD4C" Version="1.1.0.0" />

	<Properties>
		<DisplayName>ForgeKitRk - Developer Toolkit</DisplayName>
		<PublisherDisplayName>Akilan Ragavaswamy</PublisherDisplayName>
		<Logo>Assets\StoreLogo.png</Logo>
		<Description>Twenty developer tools in one native Windows app: JSON, SQL and XML formatters, diff and regex validators, converters, encoders, UUID and QR generators, Markdown and HTML viewers, SVG to XAML and an HTTP request builder.</Description>
	</Properties>

	<Dependencies>
		<!-- Desktop only: ForgeKitRk is a full-trust (runFullTrust) app, so it runs on Windows
		     Desktop and not on Xbox/HoloLens/IoT. Declaring Windows.Universal would make the
		     Store select device families this package cannot support. -->
		<TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
	</Dependencies>

	<Resources>
		<Resource Language="en-US" />
	</Resources>

	<Applications>
		<Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
			<uap:VisualElements DisplayName="ForgeKitRk - Dev Tools" Description="Twenty offline developer tools: formatters, validators, converters, encoders, generators, text viewers, SVG to XAML and an HTTP request builder."
								BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
				<uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" ShortName="ForgeKitRk">
					<uap:ShowNameOnTiles>
						<uap:ShowOn Tile="square150x150Logo" />
						<uap:ShowOn Tile="wide310x150Logo" />
					</uap:ShowNameOnTiles>
				</uap:DefaultTile>
				<uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#4F46E5" />
				<uap:LockScreen BadgeLogo="Assets\LockScreenLogo.png" Notification="badge" />
			</uap:VisualElements>

			<Extensions>
				<!-- Lets another app or a shortcut jump straight to a tool: forgekitrk://tool/json-formatter -->
				<uap:Extension Category="windows.protocol">
					<uap:Protocol Name="forgekitrk">
						<uap:DisplayName>ForgeKitRk</uap:DisplayName>
						<uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
					</uap:Protocol>
				</uap:Extension>
			</Extensions>
		</Application>
	</Applications>

	<Capabilities>
		<rescap:Capability Name="runFullTrust" />
	</Capabilities>
</Package>