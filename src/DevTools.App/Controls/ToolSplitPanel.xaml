<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DevTools.App.Controls.ToolSplitPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d"
    SizeChanged="OnSizeChanged">

    <Grid x:Name="LayoutRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FirstColumn" Width="*" />
            <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
            <ColumnDefinition x:Name="SecondColumn" Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="FirstRow" Height="*" />
            <RowDefinition x:Name="SplitterRow" Height="Auto" />
            <RowDefinition x:Name="SecondRow" Height="0" />
        </Grid.RowDefinitions>

        <ContentPresenter
            x:Name="FirstPresenter"
            Content="{x:Bind FirstPane, Mode=OneWay}" />

        <!-- Keyboard-operable splitter: arrow keys move it, Home/End snap it -->
        <primitives:Thumb
            x:Name="Splitter"
            Grid.Row="1"
            Grid.Column="1"
            AutomationProperties.Name="Resize panes"
            DragDelta="OnSplitterDragDelta"
            IsTabStop="True"
            KeyDown="OnSplitterKeyDown"
            ToolTipService.ToolTip="Drag to resize. Arrow keys also work."
            UseSystemFocusVisuals="True">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border
                            x:Name="Grip"
                            Margin="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{ThemeResource DevToolsCardBorderBrush}"
                            CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>

        <ContentPresenter
            x:Name="SecondPresenter"
            Grid.Column="2"
            Content="{x:Bind SecondPane, Mode=OneWay}" />
    </Grid>
</UserControl>
