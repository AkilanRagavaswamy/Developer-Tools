<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DevTools.App.Controls.DataTableView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevTools.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Background="{ThemeResource DevToolsEditorBackgroundBrush}"
        BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource DevToolsCardCornerRadius}">

        <!--
            The outer viewer scrolls sideways and the list inside it scrolls down, so the header
            row stays put while the rows move under it, and only the rows on screen are built.
        -->
        <ScrollViewer
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Read by the code-behind, so the row stripe follows the window theme. -->
                <Border x:Name="StripeSwatch" Background="{ThemeResource DevToolsDiffValueBrush}" Visibility="Collapsed" />

                <Grid
                    Background="{ThemeResource DevToolsGutterBackgroundBrush}"
                    BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Padding="8,6"
                        FontSize="12"
                        Foreground="{ThemeResource DevToolsGutterForegroundBrush}"
                        Text="#"
                        TextAlignment="Right" />
                    <ItemsRepeater x:Name="HeaderCells" Grid.Column="1">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="controls:DataTableCellView">
                                <TextBlock
                                    Width="{x:Bind Width}"
                                    Padding="8,6"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Text}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Text}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>

                <ListView
                    x:Name="RowList"
                    Grid.Row="1"
                    AutomationProperties.Name="Table rows"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="controls:DataTableRowView">
                            <Grid
                                Background="{x:Bind Background}"
                                BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Padding="8,4"
                                    FontFamily="{StaticResource DevToolsMonospaceFont}"
                                    FontSize="12"
                                    Foreground="{ThemeResource DevToolsGutterForegroundBrush}"
                                    Text="{x:Bind Number}"
                                    TextAlignment="Right" />
                                <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind Cells}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="controls:DataTableCellView">
                                            <TextBlock
                                                Width="{x:Bind Width}"
                                                Padding="8,4"
                                                FontFamily="{StaticResource DevToolsMonospaceFont}"
                                                FontSize="12.5"
                                                Text="{x:Bind Text}"
                                                TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
