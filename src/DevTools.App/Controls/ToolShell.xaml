<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DevTools.App.Controls.ToolShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid Padding="{StaticResource DevToolsPagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                The options row is no longer here (FR-T01): it is handed to the shell on load and
                shown in the title bar, which gives the tool a whole row of its own back. The
                shell puts it in a band of its own at widths where it will not fit up there.

                Margin rather than RowSpacing: a closed InfoBar is collapsed, and collapsed
                elements contribute no margin, so the gap stays 12 px whether or not there is a
                message.
            -->
            <InfoBar
                Margin="0,0,0,12"
                IsClosable="True"
                IsOpen="{x:Bind HasMessage, Mode=OneWay}"
                Message="{x:Bind Message, Mode=OneWay}"
                Severity="{x:Bind MessageSeverity, Mode=OneWay, Converter={StaticResource SeverityToInfoBar}}" />

            <ContentPresenter Grid.Row="1" Content="{x:Bind ToolContent, Mode=OneWay}" />
        </Grid>

        <!-- Outside the padding, so the bar spans the full width like a browser's. -->
        <ProgressBar
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{x:Bind IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
