<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DevTools.App.Controls.JsonTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:json="using:DevTools.Core.Json"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Border
        Background="{ThemeResource DevToolsEditorBackgroundBrush}"
        BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource DevToolsCardCornerRadius}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: the pane's name, then the three commands a tree needs. -->
            <Grid
                Padding="12,6,6,6"
                BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                BorderThickness="0,0,0,1">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Header, Mode=OneWay}" />

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button
                        AutomationProperties.Name="Expand everything"
                        Click="OnExpandAllClick"
                        Style="{StaticResource DevToolsToolbarButtonStyle}"
                        ToolTipService.ToolTip="Expand everything">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Collapse everything"
                        Click="OnCollapseAllClick"
                        Style="{StaticResource DevToolsToolbarButtonStyle}"
                        ToolTipService.ToolTip="Collapse everything">
                        <FontIcon FontSize="14" Glyph="&#xE738;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Copy the selected path"
                        Click="OnCopyPathClick"
                        Style="{StaticResource DevToolsToolbarButtonStyle}"
                        ToolTipService.ToolTip="Copy the selected path">
                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--
                Nodes are added by hand rather than bound, so branches can report unrealised
                children and be filled on expand (FR-J11): a document with ten thousand nodes
                opens in the time it takes to parse it. In that mode the template is handed the
                TreeViewNode and has to read the row out of its Content: binding straight to
                JsonOutlineNode fails the cast, because what arrives is the node.
            -->
            <TreeView
                x:Name="Tree"
                Grid.Row="1"
                Padding="4,6"
                AutomationProperties.Name="JSON structure"
                CanDragItems="False"
                CanReorderItems="False"
                Expanding="OnNodeExpanding"
                ItemInvoked="OnItemInvoked"
                SelectionChanged="OnSelectionChanged"
                SelectionMode="Single">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="muxc:TreeViewNode">
                        <StackPanel
                            AutomationProperties.Name="{x:Bind ((json:JsonOutlineNode)Content).Path}"
                            Orientation="Horizontal"
                            Spacing="8"
                            ToolTipService.ToolTip="{x:Bind ((json:JsonOutlineNode)Content).Path}">
                            <TextBlock
                                FontFamily="{StaticResource DevToolsMonospaceFont}"
                                FontSize="12.5"
                                Foreground="{ThemeResource DevToolsSyntaxPropertyBrush}"
                                Text="{x:Bind ((json:JsonOutlineNode)Content).Name}" />

                            <!--
                                Four mutually exclusive value labels rather than one with a
                                converted brush: a converter cannot resolve a theme resource
                                against the element, only against the application, which is the
                                wrong answer once the window's theme has been switched.
                            -->
                            <TextBlock
                                FontFamily="{StaticResource DevToolsMonospaceFont}"
                                FontSize="12.5"
                                Foreground="{ThemeResource DevToolsSyntaxStringBrush}"
                                Text="{x:Bind ((json:JsonOutlineNode)Content).Summary}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind ((json:JsonOutlineNode)Content).IsString, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock
                                FontFamily="{StaticResource DevToolsMonospaceFont}"
                                FontSize="12.5"
                                Foreground="{ThemeResource DevToolsSyntaxNumberBrush}"
                                Text="{x:Bind ((json:JsonOutlineNode)Content).Summary}"
                                Visibility="{x:Bind ((json:JsonOutlineNode)Content).IsNumber, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock
                                FontFamily="{StaticResource DevToolsMonospaceFont}"
                                FontSize="12.5"
                                Foreground="{ThemeResource DevToolsSyntaxKeywordBrush}"
                                Text="{x:Bind ((json:JsonOutlineNode)Content).Summary}"
                                Visibility="{x:Bind ((json:JsonOutlineNode)Content).IsKeyword, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock
                                FontFamily="{StaticResource DevToolsMonospaceFont}"
                                FontSize="12.5"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind ((json:JsonOutlineNode)Content).ChildSummary}"
                                Visibility="{x:Bind ((json:JsonOutlineNode)Content).IsBranch, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- The selected row's path, which is the thing worth taking away from a tree. -->
            <Grid
                Grid.Row="2"
                Padding="12,5"
                BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                BorderThickness="0,1,0,0">
                <TextBlock
                    AutomationProperties.Name="Selected path"
                    FontFamily="{StaticResource DevToolsMonospaceFont}"
                    Style="{StaticResource DevToolsCaptionStyle}"
                    Text="{x:Bind SelectedPath, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
