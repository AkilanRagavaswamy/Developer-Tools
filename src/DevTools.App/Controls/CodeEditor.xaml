<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DevTools.App.Controls.CodeEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DevTools.App.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Background="{ThemeResource DevToolsEditorBackgroundBrush}"
        BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource DevToolsCardCornerRadius}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: label on the left, actions on the right -->
            <Grid
                x:Name="HeaderRow"
                Padding="10,6,6,6"
                BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                BorderThickness="0,0,0,1"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="HeaderText"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Header, Mode=OneWay}" />

                <ContentPresenter
                    x:Name="ExtraPresenter"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="{x:Bind ExtraHeaderContent, Mode=OneWay}" />

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="2">

                    <Button
                        x:Name="PasteButton"
                        AutomationProperties.Name="Paste from clipboard"
                        Command="{x:Bind PasteCommand, Mode=OneWay}"
                        Style="{StaticResource DevToolsToolbarButtonStyle}"
                        ToolTipService.ToolTip="Paste from clipboard">
                        <FontIcon FontSize="14" Glyph="&#xE77F;" />
                    </Button>

                    <Button
                        x:Name="OpenButton"
                        AutomationProperties.Name="Open a file"
                        Command="{x:Bind OpenFileCommand, Mode=OneWay}"
                        Style="{StaticResource DevToolsToolbarButtonStyle}"
                        ToolTipService.ToolTip="Open a file">
                        <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                    </Button>

                    <Button
                        x:Name="CopyButton"
                        AutomationProperties.Name="Copy to clipboard"
                        Click="OnCopyClick"
                        Command="{x:Bind CopyCommand, Mode=OneWay}"
                        Style="{StaticResource DevToolsToolbarButtonStyle}"
                        ToolTipService.ToolTip="Copy to clipboard">
                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                    </Button>

                    <Button
                        x:Name="SaveButton"
                        AutomationProperties.Name="Save as a file"
                        Command="{x:Bind SaveCommand, Mode=OneWay}"
                        Style="{StaticResource DevToolsToolbarButtonStyle}"
                        ToolTipService.ToolTip="Save as a file">
                        <FontIcon FontSize="14" Glyph="&#xE74E;" />
                    </Button>

                    <Button
                        x:Name="ClearButton"
                        AutomationProperties.Name="Clear"
                        Command="{x:Bind ClearCommand, Mode=OneWay}"
                        Style="{StaticResource DevToolsToolbarButtonStyle}"
                        ToolTipService.ToolTip="Clear">
                        <FontIcon FontSize="14" Glyph="&#xE894;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--
                Find (FR-T12). A strip between the header and the text rather than a floating
                box, because a floating one covers the very line you are looking for. Collapsed
                it costs nothing; Ctrl+F in the text opens it and Escape puts it away.
            -->
            <Grid
                x:Name="FindBar"
                Grid.Row="1"
                Padding="10,6"
                BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                BorderThickness="0,0,0,1"
                ColumnSpacing="8"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="FindQuery"
                    AutomationProperties.Name="Find in this pane"
                    KeyDown="OnFindKeyDown"
                    PlaceholderText="Find a key or value"
                    Style="{StaticResource DevToolsInlineTextBoxStyle}"
                    TextChanged="OnFindQueryChanged" />

                <TextBlock
                    Grid.Column="1"
                    MinWidth="72"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Match count"
                    Style="{StaticResource DevToolsCaptionStyle}"
                    Text="{x:Bind FindStatus, Mode=OneWay}"
                    TextAlignment="Right" />

                <Button
                    Grid.Column="2"
                    AutomationProperties.Name="Previous match"
                    Click="OnFindPreviousClick"
                    Style="{StaticResource DevToolsToolbarButtonStyle}"
                    ToolTipService.ToolTip="Previous match (Shift+Enter)">
                    <FontIcon FontSize="12" Glyph="&#xE70E;" />
                </Button>

                <Button
                    Grid.Column="3"
                    AutomationProperties.Name="Next match"
                    Click="OnFindNextClick"
                    Style="{StaticResource DevToolsToolbarButtonStyle}"
                    ToolTipService.ToolTip="Next match (Enter)">
                    <FontIcon FontSize="12" Glyph="&#xE70D;" />
                </Button>

                <ToggleButton
                    x:Name="FindMatchCase"
                    Grid.Column="4"
                    AutomationProperties.Name="Match case"
                    Checked="OnFindOptionChanged"
                    Content="Aa"
                    FontSize="12"
                    Style="{StaticResource DevToolsToolbarToggleStyle}"
                    ToolTipService.ToolTip="Match case"
                    Unchecked="OnFindOptionChanged" />

                <Button
                    Grid.Column="5"
                    AutomationProperties.Name="Close find"
                    Click="OnFindCloseClick"
                    Style="{StaticResource DevToolsToolbarButtonStyle}"
                    ToolTipService.ToolTip="Close (Esc)">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <!-- Editor surface: gutter + text -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="GutterHost"
                    SizeChanged="OnGutterHostSizeChanged"
                    Background="{ThemeResource DevToolsGutterBackgroundBrush}"
                    BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="Collapsed">
                    <Canvas x:Name="GutterClip" Width="40">
                        <TextBlock
                            x:Name="GutterText"
                            Padding="6,12,10,12"
                            HorizontalAlignment="Right"
                            AutomationProperties.AccessibilityView="Raw"
                            FontFamily="{StaticResource DevToolsMonospaceFont}"
                            Foreground="{ThemeResource DevToolsGutterForegroundBrush}"
                            IsHitTestVisible="False"
                            TextAlignment="Right"
                            TextWrapping="NoWrap">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="GutterOffset" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                </Border>

                <TextBox
                    x:Name="Editor"
                    Grid.Column="1"
                    Padding="{StaticResource DevToolsEditorTextPadding}"
                    AcceptsReturn="True"
                    AllowDrop="True"
                    Background="Transparent"
                    BorderThickness="0"
                    DragOver="OnDragOver"
                    Drop="OnDrop"
                    FontFamily="{StaticResource DevToolsMonospaceFont}"
                    IsSpellCheckEnabled="False"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionChanged="OnSelectionChanged"
                    SizeChanged="OnEditorSizeChanged"
                    TextChanged="OnEditorTextChanged"
                    TextWrapping="Wrap" />

                <!--
                    The coloured view of a read-only pane (FR-T11). It sits over the TextBox and
                    takes its place when a language is set, so editing stays plain text and only
                    what the user reads gets colour.
                -->
                <ScrollViewer
                    x:Name="ColourHost"
                    Grid.Column="1"
                    Padding="{StaticResource DevToolsEditorTextPadding}"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <local:ColourisedTextPresenter
                        x:Name="Colourised"
                        AttributeBrush="{ThemeResource DevToolsSyntaxAttributeBrush}"
                        CommentBrush="{ThemeResource DevToolsSyntaxCommentBrush}"
                        ElementBrush="{ThemeResource DevToolsSyntaxElementBrush}"
                        KeywordBrush="{ThemeResource DevToolsSyntaxKeywordBrush}"
                        NumberBrush="{ThemeResource DevToolsSyntaxNumberBrush}"
                        PropertyBrush="{ThemeResource DevToolsSyntaxPropertyBrush}"
                        PunctuationBrush="{ThemeResource DevToolsSyntaxPunctuationBrush}"
                        MatchHighlightBrush="{ThemeResource DevToolsMatchHighlightBrush}"
                        StringBrush="{ThemeResource DevToolsSyntaxStringBrush}" />
                </ScrollViewer>

                <!--
                    Placeholder shown over an empty surface (FR-T06). It lives in the text
                    column, not across the gutter, and its margin is derived from the editor's
                    own padding — so the prompt sits exactly where the first character will and
                    the text does not jump when you start typing.
                -->
                <TextBlock
                    x:Name="PlaceholderLabel"
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    IsHitTestVisible="False"
                    Text="{x:Bind PlaceholderText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>

            <!-- Footer: counters and transient status -->
            <Grid
                Grid.Row="3"
                Padding="10,5"
                BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{x:Bind ShowFooter, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    AutomationProperties.Name="Input statistics"
                    Style="{StaticResource DevToolsCaptionStyle}"
                    Text="{x:Bind FooterText, Mode=OneWay}" />

                <TextBlock
                    x:Name="CaretText"
                    Grid.Column="1"
                    Style="{StaticResource DevToolsCaptionStyle}" />
            </Grid>


            <!-- Transient "Copied" confirmation (FR-T03) -->
            <Border
                x:Name="CopiedToast"
                Grid.Row="2"
                Margin="0,0,16,16"
                Padding="10,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{ThemeResource DevToolsAccentBrush}"
                CornerRadius="4"
                Opacity="0"
                Visibility="Collapsed">
                <TextBlock
                    FontSize="12"
                    Foreground="White"
                    Text="Copied" />
            </Border>
        </Grid>
    </Border>
</UserControl>
