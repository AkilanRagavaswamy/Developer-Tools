<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>DevTools.App</RootNamespace>
    <AssemblyName>DevTools</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DevTools.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableDefaultXamlItems>true</EnableDefaultXamlItems>
    <DefaultLanguage>en-US</DefaultLanguage>
    <IsPackable>false</IsPackable>
    <!-- Program.cs provides Main so the app can be single-instanced; see Program.cs for why. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- The XAML and WinRT source generators emit code we do not own; keep the build green
         without lowering the bar for code we do own. -->
    <NoWarn>$(NoWarn);CS8618;CS8622;CA1416;IL2050;NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevTools.Core\DevTools.Core.csproj" />
    <ProjectReference Include="..\DevTools.Http\DevTools.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png" />
    <Content Include="Assets\**\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    The API Profiler's agent is not referenced by the app: it is loaded into other processes, so
    it must stay a standalone payload rather than a compile-time dependency. This builds it (always
    as AnyCPU, so its output path is fixed whatever platform the app is building for) and copies
    its output into a Profiler\ folder beside the app, where LaunchProfiler looks for it at run
    time. Driving the build explicitly — instead of a ProjectReference — keeps the app's x64/ARM64
    platform from flowing into the agent.
  -->
  <Target Name="BundleProfilerAgent"
          BeforeTargets="AssignTargetPaths"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\DevTools.Profiler.Agent\DevTools.Profiler.Agent.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=AnyCPU">
      <Output TaskParameter="TargetOutputs" ItemName="_ProfilerAgentAssembly" />
    </MSBuild>

    <ItemGroup>
      <_ProfilerAgentFile Include="%(_ProfilerAgentAssembly.RootDir)%(_ProfilerAgentAssembly.Directory)**\*.*" />
      <Content Include="@(_ProfilerAgentFile)">
        <Link>Profiler\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>

</Project>
