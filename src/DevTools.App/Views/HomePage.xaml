<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevTools.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DevTools.App.Models"
    xmlns:vm="using:DevTools.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            The star is a sibling laid over the card's corner, not a child of the card button: a
            button inside a button cannot be reached by keyboard or announced on its own. The
            card reserves a column on the right so the name never runs under the star.
        -->
        <DataTemplate x:Key="ToolCardTemplate" x:DataType="vm:ToolCard">
            <Grid>
                <Button
                    HorizontalAlignment="Stretch"
                    AutomationProperties.HelpText="{x:Bind Tool.Description}"
                    AutomationProperties.Name="{x:Bind Tool.Name}"
                    Click="OnToolCardClick"
                    Style="{StaticResource DevToolsToolCardStyle}"
                    Tag="{x:Bind Tool.Id}"
                    ToolTipService.ToolTip="{x:Bind Tool.Description}">
                    <Button.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Click="OnToggleFavoriteClick"
                                Tag="{x:Bind Tool.Id}"
                                Text="{x:Bind FavoriteLabel, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.ContextFlyout>

                    <Grid Width="228" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="34"
                            Height="34"
                            VerticalAlignment="Top"
                            Background="{ThemeResource DevToolsCardBackgroundBrush}"
                            BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource DevToolsAccentBrush}"
                                FontFamily="{x:Bind Tool.GlyphFont}"
                                Glyph="{x:Bind Tool.Glyph}" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Tool.Name}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                Height="34"
                                Style="{StaticResource DevToolsCaptionStyle}"
                                Text="{x:Bind Tool.Description}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button
                    Margin="0,6,6,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{x:Bind FavoriteLabel, Mode=OneWay}"
                    Click="OnToggleFavoriteClick"
                    Style="{StaticResource DevToolsToolbarButtonStyle}"
                    Tag="{x:Bind Tool.Id}"
                    ToolTipService.ToolTip="{x:Bind FavoriteLabel, Mode=OneWay}">
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource DevToolsAccentBrush}"
                        Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" />
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource DevToolsPagePadding}" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24">

            <!-- Greeting -->
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="{x:Bind ViewModel.Greeting}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="{x:Bind ViewModel.TotalTools}" />
                    <Run Text="developer tools, all running locally. Press Ctrl+K to jump to one." />
                </TextBlock>
            </StackPanel>

            <!-- Recent tools (FR-S06), newest first -->
            <StackPanel
                Spacing="10"
                Visibility="{x:Bind ViewModel.HasRecents, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource DevToolsAccentBrush}"
                        Glyph="&#xE81C;" />
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Recent" />
                </StackPanel>
                <ItemsRepeater ItemTemplate="{StaticResource ToolCardTemplate}" ItemsSource="{x:Bind ViewModel.RecentTools, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="12"
                            MinItemWidth="260"
                            MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <!-- Favorites (FR-S05) -->
            <StackPanel
                Spacing="10"
                Visibility="{x:Bind ViewModel.HasFavorites, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource DevToolsAccentBrush}"
                        Glyph="&#xE735;" />
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Favorites" />
                </StackPanel>
                <ItemsRepeater ItemTemplate="{StaticResource ToolCardTemplate}" ItemsSource="{x:Bind ViewModel.FavoriteTools, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="12"
                            MinItemWidth="260"
                            MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <!-- Every tool, by category -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="24" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolGroup">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource DevToolsAccentBrush}"
                                    Glyph="{x:Bind Glyph}" />
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Name}" />
                                <TextBlock
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource DevToolsCaptionStyle}"
                                    Text="{x:Bind CountLabel}" />
                            </StackPanel>
                            <ItemsRepeater ItemTemplate="{StaticResource ToolCardTemplate}" ItemsSource="{x:Bind Tools}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsStretch="Fill"
                                        MinColumnSpacing="12"
                                        MinItemWidth="260"
                                        MinRowSpacing="12" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
