<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevTools.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DevTools.App.Models"
    xmlns:vm="using:DevTools.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="ToolCardTemplate" x:DataType="models:ToolDescriptor">
            <Button
                AutomationProperties.HelpText="{x:Bind Description}"
                AutomationProperties.Name="{x:Bind Name}"
                Click="OnToolCardClick"
                Style="{StaticResource DevToolsToolCardStyle}"
                Tag="{x:Bind Id}"
                ToolTipService.ToolTip="{x:Bind Description}">
                <Button.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Click="OnToggleFavoriteClick"
                            Tag="{x:Bind Id}"
                            Text="Toggle favorite">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE734;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.ContextFlyout>

                <Grid Width="228" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="34"
                        Height="34"
                        VerticalAlignment="Top"
                        Background="{ThemeResource DevToolsCardBackgroundBrush}"
                        BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource DevToolsAccentBrush}"
                            Glyph="{x:Bind Glyph}" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Height="34"
                            Style="{StaticResource DevToolsCaptionStyle}"
                            Text="{x:Bind Description}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource DevToolsPagePadding}" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24">

            <!-- Greeting -->
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="{x:Bind ViewModel.Greeting}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="{x:Bind ViewModel.TotalTools}" />
                    <Run Text="developer tools, all running locally. Press Ctrl+K to jump to one." />
                </TextBlock>
            </StackPanel>

            <!-- Favorites (FR-S05) -->
            <StackPanel
                Spacing="10"
                Visibility="{x:Bind ViewModel.HasFavorites, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource DevToolsAccentBrush}"
                        Glyph="&#xE735;" />
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Favorites" />
                </StackPanel>
                <ItemsRepeater ItemTemplate="{StaticResource ToolCardTemplate}" ItemsSource="{x:Bind ViewModel.FavoriteTools, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="12"
                            MinItemWidth="260"
                            MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <!-- Every tool, by category -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="24" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolGroup">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource DevToolsAccentBrush}"
                                    Glyph="{x:Bind Glyph}" />
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Name}" />
                                <TextBlock
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource DevToolsCaptionStyle}"
                                    Text="{x:Bind CountLabel}" />
                            </StackPanel>
                            <ItemsRepeater ItemTemplate="{StaticResource ToolCardTemplate}" ItemsSource="{x:Bind Tools}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsStretch="Fill"
                                        MinColumnSpacing="12"
                                        MinItemWidth="260"
                                        MinRowSpacing="12" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
