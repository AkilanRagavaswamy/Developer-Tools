<?xml version="1.0" encoding="utf-8"?>
<views:ToolPageBase
    x:Class="DevTools.App.Views.Tools.ScratchpadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevTools.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DevTools.App.Views.Tools"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkp="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:DevTools.App.Views"
    xmlns:vm="using:DevTools.App.ViewModels.Tools"
    mc:Ignorable="d">

    <controls:ToolShell
        HasMessage="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
        IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
        Message="{x:Bind ViewModel.Message, Mode=OneWay}"
        MessageSeverity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}">

        <controls:ToolShell.OptionsContent>
            <StackPanel Orientation="Horizontal" Spacing="8">

                <ToggleButton
                    Height="{StaticResource DevToolsControlHeight}"
                    Padding="9,0"
                    AutomationProperties.Name="Show the note list"
                    IsChecked="{x:Bind ViewModel.IsNotesPaneOpen, Mode=TwoWay}"
                    ToolTipService.ToolTip="Show or hide the note list">
                    <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                </ToggleButton>

                <Button
                    AutomationProperties.Name="New note"
                    Command="{x:Bind ViewModel.NewNoteCommand}"
                    Style="{StaticResource DevToolsInlineAccentButtonStyle}"
                    ToolTipService.ToolTip="New note (Ctrl+N)">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE710;" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource DevToolsOptionsSeparatorStyle}" />

                <TextBox
                    Width="220"
                    AutomationProperties.Name="Note title"
                    IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}"
                    PlaceholderText="{x:Bind ViewModel.TitlePlaceholder, Mode=OneWay}"
                    Style="{StaticResource DevToolsInlineTextBoxStyle}"
                    Text="{x:Bind ViewModel.NoteTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTipService.ToolTip="Title. Leave it empty to use the first line." />

                <ComboBox
                    MinWidth="130"
                    AutomationProperties.Name="Note language"
                    IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.LanguageNames}"
                    SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}"
                    Style="{StaticResource DevToolsInlineComboStyle}"
                    ToolTipService.ToolTip="What the note is written in. Math shows a result for every line." />

                <ComboBox
                    MinWidth="110"
                    AutomationProperties.Name="Colour tag"
                    IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.Colours}"
                    SelectedIndex="{x:Bind ViewModel.ColourIndex, Mode=TwoWay}"
                    Style="{StaticResource DevToolsInlineComboStyle}"
                    ToolTipService.ToolTip="Colour tag">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScratchColour">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    VerticalAlignment="Center"
                                    Fill="{x:Bind local:ScratchpadPage.ColourBrush(Index)}"
                                    Stroke="{ThemeResource DevToolsCardBorderBrush}"
                                    StrokeThickness="1" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ToggleButton
                    Height="{StaticResource DevToolsControlHeight}"
                    Padding="9,0"
                    AutomationProperties.Name="Pin this note"
                    IsChecked="{x:Bind ViewModel.IsPinned, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}"
                    ToolTipService.ToolTip="Pin to the top of the list">
                    <FontIcon FontSize="14" Glyph="&#xE718;" />
                </ToggleButton>

                <Border Style="{StaticResource DevToolsOptionsSeparatorStyle}" />

                <Button
                    AutomationProperties.Name="Format the note"
                    Command="{x:Bind ViewModel.FormatCommand}"
                    IsEnabled="{x:Bind ViewModel.CanFormat, Mode=OneWay}"
                    Style="{StaticResource DevToolsInlineButtonStyle}"
                    ToolTipService.ToolTip="Format JSON, XML or SQL (Shift+Alt+F)">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE8E4;" />
                        <TextBlock Text="Format" />
                    </StackPanel>
                </Button>

                <DropDownButton
                    x:Name="SendButton"
                    AutomationProperties.Name="Send to a tool"
                    IsEnabled="{x:Bind ViewModel.HasCurrentNote, Mode=OneWay}"
                    Style="{StaticResource DevToolsInlineDropDownStyle}"
                    ToolTipService.ToolTip="Send the selection, or the whole note, to another tool (Ctrl+Shift+K)">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE724;" />
                        <TextBlock Text="Send to" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="SendMenu" Opening="OnSendMenuOpening" Placement="BottomEdgeAlignedLeft" />
                    </DropDownButton.Flyout>
                </DropDownButton>

                <ToggleButton
                    Height="{StaticResource DevToolsControlHeight}"
                    Padding="{StaticResource DevToolsInlinePadding}"
                    AutomationProperties.Name="Show the history of this note"
                    IsChecked="{x:Bind ViewModel.IsHistoryOpen, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.HasCurrentNote, Mode=OneWay}"
                    ToolTipService.ToolTip="Earlier versions of this note">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE81C;" />
                        <TextBlock Text="History" />
                    </StackPanel>
                </ToggleButton>

                <DropDownButton
                    AutomationProperties.Name="More note actions"
                    Style="{StaticResource DevToolsInlineDropDownStyle}">
                    <TextBlock Text="More" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Command="{x:Bind ViewModel.ImportCommand}" Text="Open a file as a new note…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8E5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Command="{x:Bind ViewModel.DuplicateCommand}"
                                IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}"
                                Text="Duplicate">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xF413;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Command="{x:Bind ViewModel.ToggleArchiveCommand}"
                                IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}"
                                Text="{x:Bind local:ScratchpadPage.ArchiveText(ViewModel.IsArchived), Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7B8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.SaveOutputCommand}" Text="Export this note… (Ctrl+S)">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind ViewModel.ExportAllCommand}" Text="Export all notes as a zip…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xF012;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                Command="{x:Bind ViewModel.DeleteCommand}"
                                IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}"
                                Text="Move to Trash">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </controls:ToolShell.OptionsContent>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NotesColumn" Width="280" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition x:Name="SideColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <!-- ================================================= note list -->
            <Border
                x:Name="NotesPane"
                Padding="0"
                Style="{StaticResource DevToolsPreviewCardStyle}"
                Visibility="{x:Bind ViewModel.IsNotesPaneOpen, Mode=OneWay}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox
                        x:Name="SearchBox"
                        Margin="10,10,10,6"
                        AutomationProperties.Name="Search notes"
                        PlaceholderText="Search notes (Ctrl+Shift+F)"
                        Style="{StaticResource DevToolsInlineTextBoxStyle}"
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <tkp:Segmented
                        Grid.Row="1"
                        Margin="10,0,10,8"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Which notes to show"
                        SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}">
                        <tkp:SegmentedItem Content="Notes" />
                        <tkp:SegmentedItem Content="Archived" />
                        <tkp:SegmentedItem Content="Trash" />
                    </tkp:Segmented>

                    <ListView
                        x:Name="NoteList"
                        Grid.Row="2"
                        Padding="0,0,0,6"
                        AutomationProperties.Name="Notes"
                        BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                        BorderThickness="0,1,0,0"
                        ItemsSource="{x:Bind ViewModel.Notes}"
                        SelectedItem="{x:Bind ViewModel.SelectedNote, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScratchNoteItem">
                                <Grid
                                    Padding="0,8"
                                    AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                    ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="4"
                                        Background="{x:Bind local:ScratchpadPage.ColourBrush(Colour), Mode=OneWay}"
                                        CornerRadius="2" />

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock
                                            MaxLines="1"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Title, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            MaxLines="1"
                                            Style="{StaticResource DevToolsCaptionStyle}"
                                            Text="{x:Bind Preview, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind HasPreview, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource DevToolsCaptionStyle}" Opacity="0.8">
                                            <Run Text="{x:Bind When, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{x:Bind LanguageName, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <FontIcon
                                        Grid.Column="2"
                                        Margin="0,2,4,0"
                                        VerticalAlignment="Top"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE840;"
                                        Visibility="{x:Bind IsPinned, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        Grid.Row="2"
                        Margin="16,24"
                        HorizontalAlignment="Center"
                        Style="{StaticResource DevToolsCaptionStyle}"
                        Text="{x:Bind ViewModel.EmptyListText, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:ScratchpadPage.Not(ViewModel.HasNotes), Mode=OneWay}" />

                    <StackPanel
                        Grid.Row="3"
                        Padding="10,8"
                        BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Spacing="8">
                        <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.CanUndoDelete, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource DevToolsCaptionStyle}"
                                Text="{x:Bind ViewModel.UndoText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.UndoDeleteCommand}"
                                Content="Undo"
                                Style="{StaticResource DevToolsInlineButtonStyle}" />
                        </Grid>
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.EmptyTrashCommand}"
                            Style="{StaticResource DevToolsInlineButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsTrashView, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="13" Glyph="&#xE74D;" />
                                <TextBlock Text="Empty Trash" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            Style="{StaticResource DevToolsCaptionStyle}"
                            Text="Saved as you type, on this PC only."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================================= editor -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsInTrash, Mode=OneWay}"
                    Message="{x:Bind ViewModel.TrashBannerText, Mode=OneWay}"
                    Severity="Informational">
                    <InfoBar.Content>
                        <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.RestoreNoteCommand}" Content="Restore" />
                            <Button Command="{x:Bind ViewModel.DeleteForeverCommand}" Content="Delete for good" />
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>

                <InfoBar
                    Grid.Row="1"
                    CloseButtonCommand="{x:Bind ViewModel.DismissSecretCommand}"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasSecretWarning, Mode=OneWay}"
                    Message="{x:Bind ViewModel.SecretWarning, Mode=OneWay}"
                    Severity="Warning"
                    Title="Possible secret" />

                <InfoBar
                    Grid.Row="2"
                    CloseButtonCommand="{x:Bind ViewModel.DismissLanguageSuggestionCommand}"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasLanguageSuggestion, Mode=OneWay}"
                    Message="{x:Bind ViewModel.LanguageSuggestion, Mode=OneWay}"
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button Command="{x:Bind ViewModel.ApplyLanguageSuggestionCommand}" Content="Set language" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <controls:CodeEditor
                    x:Name="Editor"
                    Grid.Row="3"
                    CanSendToScratchpad="False"
                    ClearCommand="{x:Bind ViewModel.ClearCommand}"
                    CopyCommand="{x:Bind ViewModel.CopyNoteCommand}"
                    FooterText="{x:Bind ViewModel.Footer, Mode=OneWay}"
                    Header="Note"
                    IsReadOnly="{x:Bind ViewModel.IsInTrash, Mode=OneWay}"
                    OpenFileCommand="{x:Bind ViewModel.ImportCommand}"
                    PlaceholderText="Jot anything down. It is saved as you type and kept between sessions; earlier versions are in History. Set the language to Math to get a result on every line."
                    SaveCommand="{x:Bind ViewModel.SaveOutputCommand}"
                    Text="{x:Bind ViewModel.Text, Mode=TwoWay}" />
            </Grid>

            <!-- ================================================= side panel: history or results -->
            <Border
                x:Name="SidePane"
                Grid.Column="2"
                Padding="0"
                Style="{StaticResource DevToolsPreviewCardStyle}"
                Visibility="{x:Bind ViewModel.ShowSidePanel, Mode=OneWay}">
                <Grid>
                    <!-- History -->
                    <Grid Visibility="{x:Bind ViewModel.IsHistoryOpen, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            Padding="12,8,6,8"
                            BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="History" />
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="Close history"
                                Command="{x:Bind ViewModel.ToggleHistoryCommand}"
                                Style="{StaticResource DevToolsToolbarButtonStyle}"
                                ToolTipService.ToolTip="Close">
                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                            </Button>
                        </Grid>

                        <ListView
                            Grid.Row="1"
                            AutomationProperties.Name="Saved versions"
                            ItemsSource="{x:Bind ViewModel.History}"
                            SelectedItem="{x:Bind ViewModel.SelectedSnapshot, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScratchSnapshotItem">
                                    <Grid
                                        Padding="0,6"
                                        AutomationProperties.Name="{x:Bind AccessibleName}"
                                        ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind When}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource DevToolsCaptionStyle}"
                                            Text="{x:Bind Size}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            Grid.Row="1"
                            Margin="16,24"
                            Style="{StaticResource DevToolsCaptionStyle}"
                            Text="No earlier versions yet. One is kept after a minute without typing, every few minutes while you type, and before anything replaces the whole note."
                            TextWrapping="Wrap"
                            Visibility="{x:Bind local:ScratchpadPage.Not(ViewModel.HasHistory), Mode=OneWay}" />

                        <Grid
                            Grid.Row="2"
                            Padding="10,8"
                            BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                            BorderThickness="0,1,0,1"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.RestoreSnapshotCommand}"
                                Content="Restore"
                                IsEnabled="{x:Bind ViewModel.HasSnapshotSelected, Mode=OneWay}"
                                Style="{StaticResource DevToolsInlineButtonStyle}"
                                ToolTipService.ToolTip="Put this version back. The current text is kept as a version too." />
                            <Button
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.CompareSnapshotCommand}"
                                Content="Compare"
                                IsEnabled="{x:Bind ViewModel.HasSnapshotSelected, Mode=OneWay}"
                                Style="{StaticResource DevToolsInlineButtonStyle}"
                                ToolTipService.ToolTip="Open this version and the current text in Text Compare" />
                        </Grid>

                        <ScrollViewer
                            Grid.Row="3"
                            Padding="12,8"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto">
                            <TextBlock
                                AutomationProperties.Name="Preview of the selected version"
                                FontFamily="{StaticResource DevToolsMonospaceFont}"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.SnapshotPreview, Mode=OneWay}" />
                        </ScrollViewer>

                        <TextBlock
                            Grid.Row="4"
                            Padding="12,6"
                            Style="{StaticResource DevToolsCaptionStyle}"
                            Text="{x:Bind local:ScratchpadPage.RetentionText(ViewModel.HasCurrentNote), Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Grid>

                    <!-- Math results -->
                    <Grid Visibility="{x:Bind ViewModel.ShowMathPanel, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Padding="12,10"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Results" />

                        <ListView
                            Grid.Row="1"
                            AutomationProperties.Name="Calculation results"
                            BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                            BorderThickness="0,1,0,1"
                            IsItemClickEnabled="True"
                            ItemClick="OnMathRowClick"
                            ItemsSource="{x:Bind ViewModel.MathRows}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScratchMathRow">
                                    <Grid
                                        Padding="0,6"
                                        AutomationProperties.Name="{x:Bind AccessibleName}"
                                        ColumnSpacing="10"
                                        ToolTipService.ToolTip="{x:Bind local:ScratchpadPage.RowTip(Error)}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1">
                                            <TextBlock
                                                Opacity="0.8"
                                                Style="{StaticResource DevToolsCaptionStyle}"
                                                Text="{x:Bind LineLabel}" />
                                            <TextBlock
                                                FontFamily="{StaticResource DevToolsMonospaceFont}"
                                                FontSize="12"
                                                MaxLines="1"
                                                Style="{StaticResource DevToolsCaptionStyle}"
                                                Text="{x:Bind Source}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DevToolsMonospaceFont}"
                                            Foreground="{x:Bind local:ScratchpadPage.ResultBrush(IsError)}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            Grid.Row="2"
                            Padding="12,6"
                            Style="{StaticResource DevToolsCaptionStyle}"
                            Text="{x:Bind ViewModel.MathSummary, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </controls:ToolShell>
</views:ToolPageBase>
