<?xml version="1.0" encoding="utf-8"?>
<views:ToolPageBase
    x:Class="DevTools.App.Views.Tools.UuidGeneratorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevTools.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkp="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:DevTools.App.Views"
    mc:Ignorable="d">

    <controls:ToolShell
        HasMessage="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
        IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
        Message="{x:Bind ViewModel.Message, Mode=OneWay}"
        MessageSeverity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
>

        <controls:ToolShell.OptionsContent>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <tkp:Segmented
                    VerticalAlignment="Center"
                    AutomationProperties.Name="UUID version"
                    SelectedIndex="{x:Bind ViewModel.VersionIndex, Mode=TwoWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.VersionHint, Mode=OneWay}">
                    <tkp:SegmentedItem Content="v4" />
                    <tkp:SegmentedItem Content="v7" />
                    <tkp:SegmentedItem Content="v1" />
                    <tkp:SegmentedItem Content="Nil" />
                </tkp:Segmented>

                <ComboBox
                    Grid.Column="1"
                    MinWidth="150"
                    AutomationProperties.Name="Format"
                    SelectedIndex="{x:Bind ViewModel.FormatIndex, Mode=TwoWay}"
                    Style="{StaticResource DevToolsInlineComboStyle}"
                    ToolTipService.ToolTip="Format">
                    <ComboBoxItem Content="Hyphenated" />
                    <ComboBoxItem Content="No hyphens" />
                    <ComboBoxItem Content="{}{Braces}" />
                    <ComboBoxItem Content="urn:uuid:" />
                </ComboBox>

                <CheckBox
                    Grid.Column="2"
                    AutomationProperties.Name="Uppercase"
                    Content="Uppercase"
                    IsChecked="{x:Bind ViewModel.Uppercase, Mode=TwoWay}"
                    Style="{StaticResource DevToolsInlineCheckBoxStyle}" />

                <NumberBox
                    Grid.Column="4"
                    Width="130"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="How many to generate"
                    LargeChange="100"
                    Maximum="10000"
                    Minimum="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ToolTipService.ToolTip="How many (up to 10,000)"
                    Value="{x:Bind ViewModel.Count, Mode=TwoWay}" />

                <Button
                    Grid.Column="5"
                    AutomationProperties.Name="Generate new UUIDs"
                    Command="{x:Bind ViewModel.RunCommand}"
                    Style="{StaticResource DevToolsInlineAccentButtonStyle}"
                    ToolTipService.ToolTip="Generate new UUIDs (Ctrl+Enter)">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                        <TextBlock Text="Generate" />
                    </StackPanel>
                </Button>
            </Grid>
        </controls:ToolShell.OptionsContent>

        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:CodeEditor
                CopyCommand="{x:Bind ViewModel.CopyOutputCommand}"
                FooterText="{x:Bind ViewModel.OutputStats, Mode=OneWay}"
                Header="UUIDs"
                IsReadOnly="True"
                SaveCommand="{x:Bind ViewModel.SaveOutputCommand}"
                Text="{x:Bind ViewModel.Output, Mode=OneWay}" />

            <!-- The other half of the job: what is this UUID I was handed? -->
            <Border Grid.Row="1" Style="{StaticResource DevToolsCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource DevToolsOptionLabelStyle}"
                        Text="Inspect" />
                    <TextBox
                        Grid.Column="1"
                        AutomationProperties.Name="A UUID to inspect"
                        FontFamily="{StaticResource DevToolsMonospaceFont}"
                        PlaceholderText="Paste a UUID to see its version"
                        Style="{StaticResource DevToolsInlineTextBoxStyle}"
                        Text="{x:Bind ViewModel.InspectText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.InspectResult, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Grid>
    </controls:ToolShell>
</views:ToolPageBase>
