<?xml version="1.0" encoding="utf-8"?>
<views:ToolPageBase
    x:Class="DevTools.App.Views.Tools.JsonToTablePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevTools.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:DevTools.App.Views"
    mc:Ignorable="d">

    <controls:ToolShell
        HasMessage="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
        IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
        Message="{x:Bind ViewModel.Message, Mode=OneWay}"
        MessageSeverity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
>

        <controls:ToolShell.OptionsContent>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    AutomationProperties.Name="Spread nested objects into columns of their own"
                    Content="Flatten nested objects"
                    IsChecked="{x:Bind ViewModel.FlattenObjects, Mode=TwoWay}"
                    Style="{StaticResource DevToolsInlineCheckBoxStyle}"
                    ToolTipService.ToolTip="address.city becomes a column; turn off to keep each nested object as JSON in one cell" />

                <DropDownButton
                    Grid.Column="2"
                    AutomationProperties.Name="Copy the table"
                    IsEnabled="{x:Bind ViewModel.HasTable, Mode=OneWay}"
                    Style="{StaticResource DevToolsInlineDropDownStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                        <TextBlock Text="Copy as" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Command="{x:Bind ViewModel.CopyAsCommand}" CommandParameter="tsv" Text="Tab-separated (pastes into Excel)" />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.CopyAsCommand}" CommandParameter="csv" Text="CSV" />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.CopyAsCommand}" CommandParameter="md" Text="Markdown table" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>
        </controls:ToolShell.OptionsContent>

        <controls:ToolSplitPanel>
            <controls:ToolSplitPanel.FirstPane>
                <controls:CodeEditor
                    Margin="0,0,5,0"
                    ClearCommand="{x:Bind ViewModel.ClearCommand}"
                    FooterText="{x:Bind ViewModel.InputStats, Mode=OneWay}"
                    Header="JSON"
                    OpenFileCommand="{x:Bind ViewModel.OpenFileCommand}"
                    PasteCommand="{x:Bind ViewModel.PasteCommand}"
                    PlaceholderText="Paste a JSON array of objects. Every member any element has becomes a column, numbers keep their exact text, and arrays stay as JSON in their cell."
                    Text="{x:Bind ViewModel.Input, Mode=TwoWay}" />
            </controls:ToolSplitPanel.FirstPane>

            <controls:ToolSplitPanel.SecondPane>
                <Grid Margin="5,0,0,0" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:DataTableView Table="{x:Bind ViewModel.Table, Mode=OneWay}" />

                    <!-- The empty state, in the place the table will be. -->
                    <TextBlock
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource DevToolsCaptionStyle}"
                        Text="The table appears here."
                        Visibility="{x:Bind ViewModel.HasTable, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource DevToolsCaptionStyle}"
                            Text="{x:Bind ViewModel.StatsText, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            AutomationProperties.Name="Save as CSV"
                            Command="{x:Bind ViewModel.SaveOutputCommand}"
                            IsEnabled="{x:Bind ViewModel.HasTable, Mode=OneWay}"
                            Style="{StaticResource DevToolsToolbarButtonStyle}"
                            ToolTipService.ToolTip="Save as CSV (Ctrl+S)">
                            <FontIcon FontSize="14" Glyph="&#xE74E;" />
                        </Button>
                    </Grid>
                </Grid>
            </controls:ToolSplitPanel.SecondPane>
        </controls:ToolSplitPanel>
    </controls:ToolShell>
</views:ToolPageBase>
