<?xml version="1.0" encoding="utf-8"?>
<views:ToolPageBase
    x:Class="DevTools.App.Views.Tools.Base64ImagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevTools.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:DevTools.App.Views"
    mc:Ignorable="d">

    <controls:ToolShell
        HasMessage="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
        IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
        Message="{x:Bind ViewModel.Message, Mode=OneWay}"
        MessageSeverity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
>

        <controls:ToolShell.OptionsContent>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    AutomationProperties.Name="Open an image file"
                    Command="{x:Bind ViewModel.OpenImageCommand}"
                    Style="{StaticResource DevToolsInlineAccentButtonStyle}"
                    ToolTipService.ToolTip="Open an image to encode it">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE838;" />
                        <TextBlock Text="Open image" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="Encode the image on the clipboard"
                    Command="{x:Bind ViewModel.PasteImageCommand}"
                    Style="{StaticResource DevToolsInlineButtonStyle}"
                    ToolTipService.ToolTip="Encode the image on the clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE77F;" />
                        <TextBlock Text="Paste image" />
                    </StackPanel>
                </Button>

                <CheckBox
                    Grid.Column="3"
                    AutomationProperties.Name="Write a data URI rather than bare Base64"
                    Content="Data URI"
                    IsChecked="{x:Bind ViewModel.AsDataUri, Mode=TwoWay}"
                    Style="{StaticResource DevToolsInlineCheckBoxStyle}"
                    ToolTipService.ToolTip="data:image/png;base64,… — ready for an img src or a CSS url()" />
            </Grid>
        </controls:ToolShell.OptionsContent>

        <controls:ToolSplitPanel>
            <controls:ToolSplitPanel.FirstPane>
                <controls:CodeEditor
                    Margin="0,0,5,0"
                    AllowFileDrop="False"
                    ClearCommand="{x:Bind ViewModel.ClearCommand}"
                    CopyCommand="{x:Bind ViewModel.CopyInputCommand}"
                    FooterText="{x:Bind ViewModel.InputStats, Mode=OneWay}"
                    Header="Base64 or data URI"
                    OpenFileCommand="{x:Bind ViewModel.OpenFileCommand}"
                    PasteCommand="{x:Bind ViewModel.PasteCommand}"
                    PlaceholderText="Paste Base64 or a data: URI to see the image — or open, paste or drop an image to get its Base64."
                    Text="{x:Bind ViewModel.Input, Mode=TwoWay}" />
            </controls:ToolSplitPanel.FirstPane>

            <controls:ToolSplitPanel.SecondPane>
                <Border
                    x:Name="DropTarget"
                    Margin="5,0,0,0"
                    AllowDrop="True"
                    DragOver="OnDragOver"
                    Drop="OnDrop"
                    Style="{StaticResource DevToolsPreviewCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            Padding="12,8"
                            BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Image" />
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="Copy the image"
                                Command="{x:Bind ViewModel.CopyImageCommand}"
                                IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                Style="{StaticResource DevToolsToolbarButtonStyle}"
                                ToolTipService.ToolTip="Copy the image">
                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                            </Button>
                            <Button
                                Grid.Column="2"
                                AutomationProperties.Name="Save the image"
                                Command="{x:Bind ViewModel.SaveImageCommand}"
                                IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                Style="{StaticResource DevToolsToolbarButtonStyle}"
                                ToolTipService.ToolTip="Save the image (Ctrl+S)">
                                <FontIcon FontSize="14" Glyph="&#xE74E;" />
                            </Button>
                        </Grid>

                        <controls:CheckerboardPanel Grid.Row="1">
                            <Grid>
                                <Image
                                    x:Name="Preview"
                                    Margin="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Decoded image"
                                    ImageOpened="OnImageOpened"
                                    Stretch="Uniform" />

                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8"
                                    Visibility="{x:Bind ViewModel.HasImage, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                    <FontIcon
                                        FontSize="32"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xEB9F;" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource DevToolsCaptionStyle}"
                                        Text="Drop an image here" />
                                </StackPanel>
                            </Grid>
                        </controls:CheckerboardPanel>

                        <TextBlock
                            Grid.Row="2"
                            Padding="12,6"
                            Style="{StaticResource DevToolsCaptionStyle}"
                            Text="{x:Bind ViewModel.ImageInfo, Mode=OneWay}" />
                    </Grid>
                </Border>
            </controls:ToolSplitPanel.SecondPane>
        </controls:ToolSplitPanel>
    </controls:ToolShell>
</views:ToolPageBase>
