<?xml version="1.0" encoding="utf-8"?>
<views:ToolPageBase
    x:Class="DevTools.App.Views.Tools.RegexValidatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevTools.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="using:DevTools.App.ViewModels.Tools"
    xmlns:views="using:DevTools.App.Views"
    mc:Ignorable="d">

    <controls:ToolShell
        HasMessage="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
        IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
        Message="{x:Bind ViewModel.Message, Mode=OneWay}"
        MessageSeverity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}">

        <controls:ToolShell.OptionsContent>
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    Content="Ignore case"
                    IsChecked="{x:Bind ViewModel.IgnoreCase, Mode=TwoWay}"
                    Style="{StaticResource DevToolsInlineCheckBoxStyle}"
                    ToolTipService.ToolTip="RegexOptions.IgnoreCase (i)" />
                <CheckBox
                    Grid.Column="1"
                    Content="Multiline"
                    IsChecked="{x:Bind ViewModel.Multiline, Mode=TwoWay}"
                    Style="{StaticResource DevToolsInlineCheckBoxStyle}"
                    ToolTipService.ToolTip="^ and $ match at every line (m)" />
                <CheckBox
                    Grid.Column="2"
                    Content="Dot matches newline"
                    IsChecked="{x:Bind ViewModel.Singleline, Mode=TwoWay}"
                    Style="{StaticResource DevToolsInlineCheckBoxStyle}"
                    ToolTipService.ToolTip="RegexOptions.Singleline (s)" />

                <DropDownButton
                    Grid.Column="4"
                    AutomationProperties.Name="More options"
                    Style="{StaticResource DevToolsInlineDropDownStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="More" />
                        <Border
                            Style="{StaticResource DevToolsCountBadgeStyle}"
                            Visibility="{x:Bind ViewModel.HasMoreOptions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource DevToolsCountBadgeTextStyle}" Text="{x:Bind ViewModel.MoreOptionCount, Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.IgnorePatternWhitespace, Mode=TwoWay}" Text="Ignore whitespace in the pattern (x)" />
                            <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.ExplicitCapture, Mode=TwoWay}" Text="Only named groups capture (n)" />
                            <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.EcmaScript, Mode=TwoWay}" Text="JavaScript (ECMAScript) behaviour" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>
        </controls:ToolShell.OptionsContent>

        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource DevToolsCardStyle}">
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource DevToolsOptionLabelStyle}" Text="Pattern" />
                    <TextBox
                        Grid.Row="1"
                        AutomationProperties.Name="Regular expression"
                        FontFamily="{StaticResource DevToolsMonospaceFont}"
                        FontSize="15"
                        IsSpellCheckEnabled="False"
                        PlaceholderText="\b(?&lt;word&gt;\w+)@(?&lt;domain&gt;[\w.]+)\b"
                        Text="{x:Bind ViewModel.Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource DevToolsOptionLabelStyle}"
                        Text="Replace with (optional)" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        AutomationProperties.Name="Replacement"
                        FontFamily="{StaticResource DevToolsMonospaceFont}"
                        FontSize="15"
                        IsSpellCheckEnabled="False"
                        PlaceholderText="$1 or ${word}"
                        Text="{x:Bind ViewModel.Replacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>

            <controls:ToolSplitPanel Grid.Row="1">
                <controls:ToolSplitPanel.FirstPane>
                    <controls:CodeEditor
                        Margin="0,0,5,0"
                        ClearCommand="{x:Bind ViewModel.ClearCommand}"
                        FooterText="{x:Bind ViewModel.InputStats, Mode=OneWay}"
                        Header="Test text"
                        OpenFileCommand="{x:Bind ViewModel.OpenFileCommand}"
                        PasteCommand="{x:Bind ViewModel.PasteCommand}"
                        PlaceholderText="Paste the text to test the pattern against. Every evaluation stops after two seconds, so a pattern that backtracks catastrophically cannot freeze the app."
                        Text="{x:Bind ViewModel.Input, Mode=TwoWay}" />
                </controls:ToolSplitPanel.FirstPane>

                <controls:ToolSplitPanel.SecondPane>
                    <Grid Margin="5,0,0,0" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource DevToolsPreviewCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid
                                    Padding="12,10"
                                    BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Matches" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DevToolsCaptionStyle}"
                                        Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <ScrollViewer Grid.Row="1" Padding="12,8" VerticalScrollBarVisibility="Auto">
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Matches}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="8" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="tools:RegexMatchRow">
                                                <Border
                                                    Padding="10,8"
                                                    Background="{ThemeResource DevToolsCardBackgroundBrush}"
                                                    BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource DevToolsCardCornerRadius}">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Style="{StaticResource DevToolsCaptionStyle}" Text="{x:Bind Header}" />
                                                        <TextBlock
                                                            FontFamily="{StaticResource DevToolsMonospaceFont}"
                                                            IsTextSelectionEnabled="True"
                                                            Text="{x:Bind Value}"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            FontFamily="{StaticResource DevToolsMonospaceFont}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            IsTextSelectionEnabled="True"
                                                            Text="{x:Bind Groups}"
                                                            TextWrapping="Wrap"
                                                            Visibility="{x:Bind HasGroups}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <controls:CodeEditor
                            Grid.Row="1"
                            Height="220"
                            CopyCommand="{x:Bind ViewModel.CopyOutputCommand}"
                            Header="After replacement"
                            IsReadOnly="True"
                            SaveCommand="{x:Bind ViewModel.SaveOutputCommand}"
                            Text="{x:Bind ViewModel.Output, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasReplacement, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </controls:ToolSplitPanel.SecondPane>
            </controls:ToolSplitPanel>
        </Grid>
    </controls:ToolShell>
</views:ToolPageBase>
