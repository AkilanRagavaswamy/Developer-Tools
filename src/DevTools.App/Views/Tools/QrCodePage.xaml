<?xml version="1.0" encoding="utf-8"?>
<views:ToolPageBase
    x:Class="DevTools.App.Views.Tools.QrCodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevTools.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkp="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:DevTools.App.Views"
    mc:Ignorable="d">

    <controls:ToolShell
        HasMessage="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
        IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
        Message="{x:Bind ViewModel.Message, Mode=OneWay}"
        MessageSeverity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
>

        <controls:ToolShell.OptionsContent>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <tkp:Segmented
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Error correction"
                    SelectedIndex="{x:Bind ViewModel.ErrorCorrectionIndex, Mode=TwoWay}"
                    ToolTipService.ToolTip="Error correction: how much of the code can be damaged and still read">
                    <tkp:SegmentedItem Content="L" ToolTipService.ToolTip="Low — about 7%, the smallest code" />
                    <tkp:SegmentedItem Content="M" ToolTipService.ToolTip="Medium — about 15%" />
                    <tkp:SegmentedItem Content="Q" ToolTipService.ToolTip="Quartile — about 25%" />
                    <tkp:SegmentedItem Content="H" ToolTipService.ToolTip="High — about 30%, survives a logo over the middle" />
                </tkp:Segmented>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Style="{StaticResource DevToolsOptionLabelStyle}" Text="Margin" />
                <NumberBox
                    Width="110"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Quiet zone in modules"
                    Maximum="16"
                    Minimum="0"
                    SpinButtonPlacementMode="Inline"
                    ToolTipService.ToolTip="Quiet zone (margin) in modules — scanners expect 4"
                    Value="{x:Bind ViewModel.Margin, Mode=TwoWay}" />
                </StackPanel>

                <DropDownButton
                    Grid.Column="3"
                    AutomationProperties.Name="Colours"
                    Style="{StaticResource DevToolsInlineDropDownStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE790;" />
                        <TextBlock Text="Colours" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="300" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{x:Bind ViewModel.UsePresetCommand}" CommandParameter="default" Content="Black on white" />
                                    <Button Command="{x:Bind ViewModel.UsePresetCommand}" CommandParameter="inverse" Content="Inverted" />
                                    <Button Command="{x:Bind ViewModel.UsePresetCommand}" CommandParameter="transparent" Content="Transparent" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource DevToolsOptionLabelStyle}" Text="Modules" />
                                <ColorPicker
                                    ColorSpectrumShape="Box"
                                    IsAlphaEnabled="False"
                                    IsColorChannelTextInputVisible="False"
                                    IsColorSliderVisible="True"
                                    IsHexInputVisible="True"
                                    IsMoreButtonVisible="False"
                                    Color="{x:Bind ViewModel.DarkColor, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource DevToolsOptionLabelStyle}" Text="Background" />
                                <ColorPicker
                                    ColorSpectrumShape="Box"
                                    IsAlphaEnabled="True"
                                    IsColorChannelTextInputVisible="False"
                                    IsColorSliderVisible="True"
                                    IsHexInputVisible="True"
                                    IsMoreButtonVisible="False"
                                    Color="{x:Bind ViewModel.LightColor, Mode=TwoWay}" />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>
        </controls:ToolShell.OptionsContent>

        <controls:ToolSplitPanel>
            <controls:ToolSplitPanel.FirstPane>
                <controls:CodeEditor
                    Margin="0,0,5,0"
                    ClearCommand="{x:Bind ViewModel.ClearCommand}"
                    FooterText="{x:Bind ViewModel.InputStats, Mode=OneWay}"
                    Header="Text or URL"
                    OpenFileCommand="{x:Bind ViewModel.OpenFileCommand}"
                    PasteCommand="{x:Bind ViewModel.PasteCommand}"
                    PlaceholderText="Type a URL or any text. Wi-Fi: WIFI:T:WPA;S:network;P:password;;  ·  E-mail: mailto:someone@example.com"
                    Text="{x:Bind ViewModel.Input, Mode=TwoWay}" />
            </controls:ToolSplitPanel.FirstPane>

            <controls:ToolSplitPanel.SecondPane>
                <Border Margin="5,0,0,0" Style="{StaticResource DevToolsPreviewCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            Padding="12,8"
                            BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="QR code" />

                            <ComboBox
                                Grid.Column="1"
                                MinWidth="110"
                                AutomationProperties.Name="PNG size"
                                SelectedIndex="{x:Bind ViewModel.ExportSizeIndex, Mode=TwoWay}"
                                Style="{StaticResource DevToolsInlineComboStyle}"
                                ToolTipService.ToolTip="Size of a saved or copied PNG">
                                <ComboBoxItem Content="512 px" />
                                <ComboBoxItem Content="1024 px" />
                                <ComboBoxItem Content="2048 px" />
                                <ComboBoxItem Content="4096 px" />
                            </ComboBox>

                            <Button
                                Grid.Column="2"
                                AutomationProperties.Name="Copy"
                                IsEnabled="{x:Bind ViewModel.HasCode, Mode=OneWay}"
                                Style="{StaticResource DevToolsToolbarButtonStyle}"
                                ToolTipService.ToolTip="Copy">
                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.CopyImageCommand}" Text="Copy image" />
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.CopySvgCommand}" Text="Copy SVG markup" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <Button
                                Grid.Column="3"
                                AutomationProperties.Name="Save"
                                IsEnabled="{x:Bind ViewModel.HasCode, Mode=OneWay}"
                                Style="{StaticResource DevToolsToolbarButtonStyle}"
                                ToolTipService.ToolTip="Save">
                                <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.SavePngCommand}" Text="Save as PNG…" />
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.SaveSvgCommand}" Text="Save as SVG…" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <controls:CheckerboardPanel Grid.Row="1">
                            <Grid>
                                <!-- Nearest-neighbour scaling keeps every module edge sharp. -->
                                <Image
                                    x:Name="Preview"
                                    Margin="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="QR code preview"
                                    Stretch="Uniform" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DevToolsCaptionStyle}"
                                    Text="The QR code appears here."
                                    Visibility="{x:Bind ViewModel.HasCode, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                            </Grid>
                        </controls:CheckerboardPanel>

                        <TextBlock
                            Grid.Row="2"
                            Padding="12,6"
                            Style="{StaticResource DevToolsCaptionStyle}"
                            Text="{x:Bind ViewModel.StatsText, Mode=OneWay}" />
                    </Grid>
                </Border>
            </controls:ToolSplitPanel.SecondPane>
        </controls:ToolSplitPanel>
    </controls:ToolShell>
</views:ToolPageBase>
