<?xml version="1.0" encoding="utf-8"?>
<views:ToolPageBase
    x:Class="DevTools.App.Views.Tools.TextComparePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevTools.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkp="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:DevTools.App.Views"
    mc:Ignorable="d">

    <controls:ToolShell
        HasMessage="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
        IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
        Message="{x:Bind ViewModel.Message, Mode=OneWay}"
        MessageSeverity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
>

        <controls:ToolShell.OptionsContent>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <tkp:Segmented
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Layout"
                    SelectedIndex="{x:Bind ViewModel.ViewIndex, Mode=TwoWay}"
                    ToolTipService.ToolTip="Layout">
                    <tkp:SegmentedItem Content="Side by side" />
                    <tkp:SegmentedItem Content="Inline" />
                </tkp:Segmented>

                <DropDownButton
                    Grid.Column="1"
                    AutomationProperties.Name="Comparison settings"
                    Style="{StaticResource DevToolsInlineDropDownStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="Comparison" />
                        <Border
                            Style="{StaticResource DevToolsCountBadgeStyle}"
                            Visibility="{x:Bind ViewModel.HasComparisonOptions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource DevToolsCountBadgeTextStyle}" Text="{x:Bind ViewModel.ComparisonCount, Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="260" Spacing="10">
                                <TextBlock Style="{StaticResource DevToolsOptionLabelStyle}" Text="Whitespace" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Whitespace"
                                    SelectedIndex="{x:Bind ViewModel.WhitespaceIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Compare it" />
                                    <ComboBoxItem Content="Ignore at line ends" />
                                    <ComboBoxItem Content="Ignore all of it" />
                                </ComboBox>
                                <CheckBox Content="Ignore case" IsChecked="{x:Bind ViewModel.IgnoreCase, Mode=TwoWay}" />
                                <CheckBox Content="Ignore blank lines" IsChecked="{x:Bind ViewModel.IgnoreBlankLines, Mode=TwoWay}" />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Button
                    Grid.Column="3"
                    AutomationProperties.Name="Copy as a unified diff"
                    Command="{x:Bind ViewModel.CopyOutputCommand}"
                    Style="{StaticResource DevToolsInlineButtonStyle}"
                    ToolTipService.ToolTip="Copy as a unified diff (the format git and patch read)">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                        <TextBlock Text="Copy diff" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="Export the side-by-side view as HTML"
                    Command="{x:Bind ViewModel.ExportHtmlCommand}"
                    Style="{StaticResource DevToolsInlineButtonStyle}"
                    ToolTipService.ToolTip="Save the side-by-side view as an HTML page">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xEDE1;" />
                        <TextBlock Text="Export HTML" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="4"
                    AutomationProperties.Name="Swap the two texts"
                    Command="{x:Bind ViewModel.SwapCommand}"
                    Style="{StaticResource DevToolsInlineButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE8AB;" />
                        <TextBlock Text="Swap" />
                    </StackPanel>
                </Button>
            </Grid>
        </controls:ToolShell.OptionsContent>

        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:ToolSplitPanel MinHeight="160">
                <controls:ToolSplitPanel.FirstPane>
                    <controls:CodeEditor
                        Margin="0,0,5,0"
                        ClearCommand="{x:Bind ViewModel.ClearLeftCommand}"
                        FooterText="{x:Bind ViewModel.LeftStats, Mode=OneWay}"
                        Header="Original"
                        OpenFileCommand="{x:Bind ViewModel.OpenLeftCommand}"
                        PasteCommand="{x:Bind ViewModel.PasteLeftCommand}"
                        PlaceholderText="Paste the original text."
                        Text="{x:Bind ViewModel.Left, Mode=TwoWay}" />
                </controls:ToolSplitPanel.FirstPane>
                <controls:ToolSplitPanel.SecondPane>
                    <controls:CodeEditor
                        Margin="5,0,0,0"
                        ClearCommand="{x:Bind ViewModel.ClearRightCommand}"
                        FooterText="{x:Bind ViewModel.RightStats, Mode=OneWay}"
                        Header="Changed"
                        OpenFileCommand="{x:Bind ViewModel.OpenRightCommand}"
                        PasteCommand="{x:Bind ViewModel.PasteRightCommand}"
                        PlaceholderText="Paste the text to compare it against."
                        Text="{x:Bind ViewModel.Right, Mode=TwoWay}" />
                </controls:ToolSplitPanel.SecondPane>
            </controls:ToolSplitPanel>

            <Border Grid.Row="1" Style="{StaticResource DevToolsCardStyle}">
                <controls:TextDiffView
                    IsInline="{x:Bind ViewModel.IsInline, Mode=OneWay}"
                    LeftHeader="Original"
                    Result="{x:Bind ViewModel.Result, Mode=OneWay}"
                    RightHeader="Changed"
                    Summary="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
            </Border>
        </Grid>
    </controls:ToolShell>
</views:ToolPageBase>
