<?xml version="1.0" encoding="utf-8"?>
<views:ToolPageBase
    x:Class="DevTools.App.Views.Tools.SvgToXamlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevTools.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkp="using:CommunityToolkit.WinUI.Controls"
    xmlns:tools="using:DevTools.App.ViewModels.Tools"
    xmlns:views="using:DevTools.App.Views"
    mc:Ignorable="d">

    <controls:ToolShell
        HasMessage="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
        IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
        Message="{x:Bind ViewModel.Message, Mode=OneWay}"
        MessageSeverity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
        OptionsWidth="890">

        <!--
            Options. Target first, because it decides which output shapes even exist; the chip
            on the right is the standing answer to the only question that matters about the
            output, which is whether XAML will actually load it.
        -->
        <controls:ToolShell.OptionsContent>
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <tkp:Segmented
                        VerticalAlignment="Center"
                        AutomationProperties.Name="XAML dialect"
                        ToolTipService.ToolTip="XAML dialect"
                        SelectedIndex="{x:Bind ViewModel.FlavorIndex, Mode=TwoWay}">
                        <tkp:SegmentedItem Content="WinUI 3" />
                        <tkp:SegmentedItem Content="WPF" />
                    </tkp:Segmented>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ComboBox
                        MinWidth="176"
                        AutomationProperties.Name="Output shape"
                        ToolTipService.ToolTip="Output shape"
                        ItemsSource="{x:Bind ViewModel.ShapeNames, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.ShapeIndex, Mode=TwoWay}"
                        Style="{StaticResource DevToolsInlineComboStyle}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBox
                        Width="150"
                        AutomationProperties.Name="Resource key"
                        ToolTipService.ToolTip="Resource key"
                        FontFamily="{StaticResource DevToolsMonospaceFont}"
                        PlaceholderText="MyIcon"
                        Style="{StaticResource DevToolsInlineTextBoxStyle}"
                        Text="{x:Bind ViewModel.ResourceKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <DropDownButton
                    Grid.Column="3"
                    AutomationProperties.Name="Coordinate precision"
                    Style="{StaticResource DevToolsInlineDropDownStyle}">
                    <TextBlock Text="Precision" />
                    <DropDownButton.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="240" Spacing="8">
                                <TextBlock
                                    Style="{StaticResource DevToolsOptionLabelStyle}"
                                    Text="Digits kept on every emitted coordinate. Fewer means smaller path data and a slightly different curve."
                                    TextWrapping="Wrap" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Decimal places"
                                    SelectedIndex="{x:Bind ViewModel.DecimalIndex, Mode=TwoWay}"
                                    Style="{StaticResource DevToolsInlineComboStyle}">
                                    <ComboBoxItem Content="1 decimal place" />
                                    <ComboBoxItem Content="2 decimal places" />
                                    <ComboBoxItem Content="3 decimal places" />
                                    <ComboBoxItem Content="4 decimal places" />
                                    <ComboBoxItem Content="6 decimal places" />
                                </ComboBox>
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- The self-test, always on screen: the output has been through XamlReader. -->
                <Border
                    Grid.Column="5"
                    Height="26"
                    Padding="11,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DevToolsPassBackgroundBrush}"
                    BorderBrush="{ThemeResource DevToolsPassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="13"
                    Visibility="{x:Bind ViewModel.OutputLoads, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="7">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource DevToolsPassForegroundBrush}"
                            Glyph="&#xE73E;" />
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource DevToolsPassForegroundBrush}"
                            Text="Output loads in XamlReader" />
                    </StackPanel>
                </Border>
            </Grid>
        </controls:ToolShell.OptionsContent>

        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="160" />
                <RowDefinition Height="2*" MinHeight="200" />
            </Grid.RowDefinitions>

            <!-- Source and output, side by side -->
            <controls:ToolSplitPanel>
                <controls:ToolSplitPanel.FirstPane>
                    <controls:CodeEditor
                        Margin="0,0,5,0"
                        ClearCommand="{x:Bind ViewModel.ClearCommand}"
                        FooterText="{x:Bind ViewModel.InputStats, Mode=OneWay}"
                        Header="SVG"
                        OpenFileCommand="{x:Bind ViewModel.OpenFileCommand}"
                        PasteCommand="{x:Bind ViewModel.PasteCommand}"
                        PlaceholderText="Paste an SVG, or drop a .svg file here. Anything outside the supported subset is reported rather than silently dropped."
                        Syntax="Xml"
                        Text="{x:Bind ViewModel.Input, Mode=TwoWay}" />
                </controls:ToolSplitPanel.FirstPane>

                <controls:ToolSplitPanel.SecondPane>
                    <controls:CodeEditor
                        Margin="5,0,0,0"
                        CopyCommand="{x:Bind ViewModel.CopyOutputCommand}"
                        FooterText="{x:Bind ViewModel.StatsText, Mode=OneWay}"
                        Header="XAML"
                        IsReadOnly="True"
                        PlaceholderText="The converted XAML appears here."
                        SaveCommand="{x:Bind ViewModel.SaveOutputCommand}"
                        Syntax="Xml"
                        Text="{x:Bind ViewModel.Output, Mode=OneWay}" />
                </controls:ToolSplitPanel.SecondPane>
            </controls:ToolSplitPanel>

            <!--
                Two previews and the report (FR-V10, FR-V11). Rendering the input with the
                platform's own SVG renderer and the output with XamlReader.Load puts the before
                and after next to each other, which is the only way to see what a dropped
                gradientTransform or a merged fill actually did to the picture.
            -->
            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="180" />
                    <ColumnDefinition Width="Auto" MinWidth="180" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource DevToolsPreviewCardStyle}">
                    <Grid Width="260">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            Padding="12,0"
                            Height="32"
                            BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Source SVG" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="rendered as-is" />
                        </Grid>

                        <controls:CheckerboardPanel Grid.Row="1">
                            <Grid>
                                <Image
                                    x:Name="SourcePreview"
                                    Margin="16"
                                    AutomationProperties.Name="Source SVG preview"
                                    Stretch="Uniform" />

                                <TextBlock
                                    Margin="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.SourceError, Mode=OneWay}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.HasSourceError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </controls:CheckerboardPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource DevToolsPreviewCardStyle}">
                    <Grid Width="260">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            Padding="12,0"
                            Height="32"
                            BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Converted XAML" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="XamlReader.Load" />
                        </Grid>

                        <controls:CheckerboardPanel Grid.Row="1">
                            <Grid>
                                <Viewbox
                                    Margin="16"
                                    Stretch="Uniform"
                                    StretchDirection="Both">
                                    <ContentPresenter x:Name="PreviewHost" AutomationProperties.Name="Converted XAML preview" />
                                </Viewbox>

                                <TextBlock
                                    Margin="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.PreviewError, Mode=OneWay}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.HasPreviewError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </controls:CheckerboardPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource DevToolsPreviewCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Padding="12,0"
                            Height="32"
                            BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Orientation="Horizontal"
                            Spacing="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="What survived the conversion" />

                            <Border
                                Padding="8,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource DevToolsPassBackgroundBrush}"
                                CornerRadius="9"
                                Visibility="{x:Bind ViewModel.ConvertedSummary, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource DevToolsPassForegroundBrush}"
                                    Text="{x:Bind ViewModel.ConvertedSummary, Mode=OneWay}" />
                            </Border>

                            <Border
                                Padding="8,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource DevToolsWarnBackgroundBrush}"
                                CornerRadius="9"
                                Visibility="{x:Bind ViewModel.HasIssues, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource DevToolsWarnForegroundBrush}"
                                    Text="{x:Bind ViewModel.IssueSummary, Mode=OneWay}" />
                            </Border>
                        </StackPanel>

                        <ListView
                            Grid.Row="1"
                            AutomationProperties.Name="Conversion report"
                            ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="tools:SvgNoteRow">
                                    <Grid
                                        Padding="0,6"
                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                        ColumnSpacing="9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            One icon per kind rather than one with a converted
                                            brush: a value converter resolves theme resources
                                            against the application, which is the wrong answer
                                            the moment the window is showing a different theme.
                                        -->
                                        <FontIcon
                                            Margin="0,2,0,0"
                                            VerticalAlignment="Top"
                                            FontSize="14"
                                            Foreground="{ThemeResource DevToolsPassForegroundBrush}"
                                            Glyph="&#xE73E;"
                                            Visibility="{x:Bind IsConverted, Converter={StaticResource BoolToVisibility}}" />

                                        <FontIcon
                                            Margin="0,2,0,0"
                                            VerticalAlignment="Top"
                                            FontSize="14"
                                            Foreground="{ThemeResource DevToolsWarnForegroundBrush}"
                                            Glyph="&#xE7BA;"
                                            Visibility="{x:Bind IsDropped, Converter={StaticResource BoolToVisibility}}" />

                                        <FontIcon
                                            Margin="0,2,0,0"
                                            VerticalAlignment="Top"
                                            FontSize="14"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xE946;"
                                            Visibility="{x:Bind IsLimitation, Converter={StaticResource BoolToVisibility}}" />

                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                FontSize="12.5"
                                                Text="{x:Bind Headline}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontSize="11.5"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind Detail}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </controls:ToolShell>
</views:ToolPageBase>
