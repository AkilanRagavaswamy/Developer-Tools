<?xml version="1.0" encoding="utf-8"?>
<views:ToolPageBase
    x:Name="PageRoot"
    x:Class="DevTools.App.Views.Tools.ApiProfilerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:capture="using:DevTools.Http.Capture"
    xmlns:controls="using:DevTools.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkp="using:CommunityToolkit.WinUI.Controls"
    xmlns:tools="using:DevTools.App.ViewModels.Tools"
    xmlns:views="using:DevTools.App.Views"
    mc:Ignorable="d">

    <controls:ToolShell
        HasMessage="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
        IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
        Message="{x:Bind ViewModel.Message, Mode=OneWay}"
        MessageSeverity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
        OptionsWidth="1250">

        <!--
            The capture bar. Process first because it is the thing you choose, then the one
            button that changes the machine, then the two controls that narrow what you are
            looking at. The counts on the right include the bytes held, because keeping whole
            response bodies is what makes this useful and what makes it expensive.
        -->
        <controls:ToolShell.OptionsContent>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <tkp:Segmented
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Capture backend"
                    IsEnabled="{x:Bind ViewModel.CanChooseBackend, Mode=OneWay}"
                    SelectedIndex="{x:Bind ViewModel.BackendIndex, Mode=TwoWay}"
                    ToolTipService.ToolTip="How calls are captured. The backend cannot change while listening.">
                    <tkp:SegmentedItem Content="Proxy" ToolTipService.ToolTip="A local proxy the machine is pointed at. Sees any app." />
                    <tkp:SegmentedItem Content="Launch app" ToolTipService.ToolTip="Loads the agent into a .NET app DevTools starts. Reads https from inside." />
                </tkp:Segmented>

                <ComboBox
                    Grid.Column="1"
                    Width="290"
                    AutomationProperties.Name="The process whose calls to show"
                    ToolTipService.ToolTip="The process whose calls to show"
                    DisplayMemberPath="Display"
                    ItemsSource="{x:Bind ViewModel.Processes, Mode=OneWay}"
                    PlaceholderText="Any process"
                    SelectedItem="{x:Bind ViewModel.SelectedProcess, Mode=TwoWay}"
                    Style="{StaticResource DevToolsInlineComboStyle}" />

                <Button
                    Grid.Column="2"
                    Width="30"
                    MinWidth="30"
                    Padding="0"
                    AutomationProperties.Name="Refresh the process list"
                    Command="{x:Bind ViewModel.RefreshProcessesCommand}"
                    Style="{StaticResource DevToolsInlineButtonStyle}"
                    ToolTipService.ToolTip="Refresh the process list">
                    <FontIcon FontSize="13" Glyph="&#xE72C;" />
                </Button>

                <Button
                    Grid.Column="3"
                    AutomationProperties.Name="Start listening"
                    Command="{x:Bind ViewModel.StartListeningCommand}"
                    Style="{StaticResource DevToolsInlineAccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsListening, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE768;" />
                        <TextBlock Text="Start listening" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="3"
                    AutomationProperties.Name="Stop listening"
                    Command="{x:Bind ViewModel.StopListeningCommand}"
                    Style="{StaticResource DevToolsInlineButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsListening, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource DevToolsWarnForegroundBrush}"
                            Glyph="&#xE71A;" />
                        <TextBlock Text="Stop listening" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="4"
                    AutomationProperties.Name="Clear the captured calls"
                    Command="{x:Bind ViewModel.ClearCapturesCommand}"
                    Content="Clear"
                    Style="{StaticResource DevToolsInlineButtonStyle}" />

                <TextBox
                    Grid.Column="5"
                    Width="220"
                    AutomationProperties.Name="Filter by host, path or status"
                    PlaceholderText="Filter host, path or status" Padding="5,7,0,0"
                    Style="{StaticResource DevToolsInlineTextBoxStyle}"
                    Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox
                    Grid.Column="6"
                    AutomationProperties.Name="Show only the calls made by the chosen process"
                    Content="Only this process"
                    IsChecked="{x:Bind ViewModel.OnlySelectedProcess, Mode=TwoWay}"
                    Style="{StaticResource DevToolsInlineCheckBoxStyle}" />

                <TextBlock
                    Grid.Column="8"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.CountsText, Mode=OneWay}" />
            </Grid>
        </controls:ToolShell.OptionsContent>

        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                What starting changes on this machine, said plainly and kept on screen while it
                is changed. A proxy setting is per user, and a tool that hides that is a tool
                that surprises you with it later.
            -->
            <Border
                Padding="12,8"
                Background="{ThemeResource DevToolsInfoBackgroundBrush}"
                BorderBrush="{ThemeResource DevToolsInfoBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource DevToolsCardCornerRadius}"
                Visibility="{x:Bind ViewModel.IsProxyMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        Text="{x:Bind ViewModel.ProxyNotice, Mode=OneWay}"
                        TextWrapping="Wrap" />

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="{x:Bind ViewModel.IsCertificateTrusted, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource DevToolsPassForegroundBrush}"
                                Glyph="&#xE72E;" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource DevToolsPassForegroundBrush}"
                                Text="Certificate trusted" />
                        </StackPanel>

                        <Button
                            AutomationProperties.Name="Copy the proxy address"
                            Command="{x:Bind ViewModel.CopyProxyAddressCommand}"
                            Content="Copy address"
                            Style="{StaticResource DevToolsInlineButtonStyle}"
                            ToolTipService.ToolTip="Paste this into the app you want to watch"
                            Visibility="{x:Bind ViewModel.NeedsManualProxy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <Button
                            AutomationProperties.Name="Remove the DevTools root certificate"
                            Command="{x:Bind ViewModel.RemoveCertificateCommand}"
                            Content="Remove certificate"
                            Style="{StaticResource DevToolsInlineButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsCertificateTrusted, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <Button
                            AutomationProperties.Name="Install the DevTools root certificate"
                            Command="{x:Bind ViewModel.InstallCertificateCommand}"
                            Content="Install certificate…"
                            Style="{StaticResource DevToolsInlineButtonStyle}"
                            ToolTipService.ToolTip="Needed to read https bodies. Windows will ask you to confirm."
                            Visibility="{x:Bind ViewModel.NeedsCertificate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                Launch mode: choose the application to start with the agent attached. No machine
                changes, so there is no proxy notice or certificate — just what to run.
            -->
            <Border
                Padding="12,8"
                Background="{ThemeResource DevToolsInfoBackgroundBrush}"
                BorderBrush="{ThemeResource DevToolsInfoBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource DevToolsCardCornerRadius}"
                Visibility="{x:Bind ViewModel.IsLaunchMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Application to launch"
                            FontFamily="{StaticResource DevToolsMonospaceFont}"
                            IsEnabled="{x:Bind ViewModel.CanChooseBackend, Mode=OneWay}"
                            PlaceholderText="Path to a .NET application (.exe)" Padding="5,7,0,0"
                            Style="{StaticResource DevToolsInlineTextBoxStyle}"
                            Text="{x:Bind ViewModel.LaunchExePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Button
                            Grid.Column="1"
                            AutomationProperties.Name="Browse for an application"
                            Command="{x:Bind ViewModel.BrowseForExeCommand}"
                            Content="Browse…"
                            IsEnabled="{x:Bind ViewModel.CanChooseBackend, Mode=OneWay}"
                            Style="{StaticResource DevToolsInlineButtonStyle}" />

                        <TextBox
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Command-line arguments"
                            FontFamily="{StaticResource DevToolsMonospaceFont}"
                            IsEnabled="{x:Bind ViewModel.CanChooseBackend, Mode=OneWay}"
                            PlaceholderText="Arguments (optional)" Padding="5,7,0,0"
                            Style="{StaticResource DevToolsInlineTextBoxStyle}"
                            Text="{x:Bind ViewModel.LaunchArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.LaunchNotice}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- The https caveat, only while it applies and only in proxy mode. -->
            <InfoBar
                Grid.Row="1"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.NeedsCertificate, Mode=OneWay}"
                Message="Without a trusted DevTools root certificate, https calls are recorded as tunnels: host, size and timing, but no headers or body. Installing one lets anything signed with it be trusted by your account, so remove it when you are done."
                Severity="Warning"
                Title="https bodies cannot be read yet"
                Visibility="{x:Bind ViewModel.IsProxyMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <Grid Grid.Row="2" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360" />
                    <ColumnDefinition Width="520" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource DevToolsPreviewCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            Height="28"
                            Padding="12,0"
                            BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="62" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DevToolsColumnHeaderStyle}" Text="#" />
                            <TextBlock Grid.Column="1" Style="{StaticResource DevToolsColumnHeaderStyle}" Text="TIME" />
                            <TextBlock Grid.Column="2" Style="{StaticResource DevToolsColumnHeaderStyle}" Text="METHOD" />
                            <TextBlock Grid.Column="3" Style="{StaticResource DevToolsColumnHeaderStyle}" Text="HOST AND PATH" />
                            <TextBlock Grid.Column="4" Style="{StaticResource DevToolsColumnHeaderStyle}" Text="STATUS" />
                            <TextBlock Grid.Column="5" Style="{StaticResource DevToolsColumnHeaderStyle}" Text="SIZE" />
                            <TextBlock Grid.Column="6" Style="{StaticResource DevToolsColumnHeaderStyle}" Text="TOOK" />
                        </Grid>

                        <ListView
                            Grid.Row="1"
                            AutomationProperties.Name="Captured calls"
                            ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="30" />
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="tools:CaptureRow">
                                    <Grid
                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                        ColumnSpacing="10"
                                        Opacity="{x:Bind RowOpacity}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="62" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock FontFamily="{StaticResource DevToolsMonospaceFont}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Index}" />
                                        <TextBlock Grid.Column="1" FontFamily="{StaticResource DevToolsMonospaceFont}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Time}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            FontFamily="{StaticResource DevToolsMonospaceFont}"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="{x:Bind Method, Converter={StaticResource MethodBrush}}"
                                            Text="{x:Bind Method, Converter={StaticResource MethodBadge}}" />

                                        <StackPanel
                                            Grid.Column="3"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <TextBlock FontFamily="{StaticResource DevToolsMonospaceFont}" FontSize="12" Text="{x:Bind Host}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind PathAndQuery}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{ThemeResource DevToolsWarnForegroundBrush}"
                                                Text="{x:Bind Note}"
                                                Visibility="{x:Bind HasNote, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="4" FontFamily="{StaticResource DevToolsMonospaceFont}" FontSize="12" Text="{x:Bind Status}" />
                                        <TextBlock Grid.Column="5" FontFamily="{StaticResource DevToolsMonospaceFont}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Size}" />
                                        <TextBlock
                                            Grid.Column="6"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Took}"
                                            TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- The empty state carries the instruction, so the list is never just blank. -->
                        <StackPanel
                            Grid.Row="1"
                            Margin="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="420"
                            Spacing="6"
                            Visibility="{x:Bind ViewModel.Rows.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Pick an app, then start listening" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Every HTTP call it makes lands in this list. Click one to read the whole exchange."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- The detail pane: request, response and timings for one call. -->
                <Border Grid.Column="1" Style="{StaticResource DevToolsPreviewCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Padding="12,10"
                            BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Spacing="5"
                            Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource DevToolsMonospaceFont}"
                                    FontSize="12.5"
                                    Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <Button
                                    Grid.Column="1"
                                    Height="26"
                                    Padding="10,0"
                                    AutomationProperties.Name="Send this call to the API Builder"
                                    Command="{x:Bind ViewModel.SendToBuilderCommand}"
                                    Content="Send to API Builder"
                                    FontSize="12"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </Grid>
                            <TextBlock
                                FontSize="11.5"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind ViewModel.DetailSubtitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Grid
                            Grid.Row="1"
                            Height="32"
                            Padding="10,0"
                            BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <tkp:Segmented
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Which half of the exchange to show"
                                SelectedIndex="{x:Bind ViewModel.DetailViewIndex, Mode=TwoWay}">
                                <tkp:SegmentedItem Content="Request" />
                                <tkp:SegmentedItem Content="Response" />
                                <tkp:SegmentedItem Content="Timings" />
                            </tkp:Segmented>

                            <Button
                                Height="24"
                                Padding="9,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Copy this call as a cURL command"
                                Command="{x:Bind ViewModel.CopyAsCurlCommand}"
                                Content="Copy as cURL"
                                FontSize="11.5" />
                        </Grid>

                        <!-- Request -->
                        <Grid
                            Grid.Row="2"
                            Visibility="{x:Bind ViewModel.IsRequestView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Padding="12,10,12,4" Spacing="6">
                                <TextBlock Style="{StaticResource DevToolsColumnHeaderStyle}" Text="HEADERS" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.DetailRequestHeaders, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="capture:CapturedHeader">
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontFamily="{StaticResource DevToolsMonospaceFont}"
                                                    FontSize="11.5"
                                                    Foreground="{ThemeResource DevToolsSyntaxPropertyBrush}"
                                                    Text="{x:Bind Name}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontFamily="{StaticResource DevToolsMonospaceFont}"
                                                    FontSize="11.5"
                                                    Text="{x:Bind Value}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <controls:CodeEditor
                                Grid.Row="1"
                                Margin="12,4,12,12"
                                Header="Request body"
                                IsReadOnly="True"
                                PlaceholderText="No request body."
                                ShowFooter="Collapsed"
                                Text="{x:Bind ViewModel.DetailRequestBody, Mode=OneWay}" />
                        </Grid>

                        <!-- Response -->
                        <Grid
                            Grid.Row="2"
                            Visibility="{x:Bind ViewModel.IsResponseView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Padding="12,10,12,4" Spacing="6">
                                <TextBlock Style="{StaticResource DevToolsColumnHeaderStyle}" Text="HEADERS" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.DetailResponseHeaders, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="capture:CapturedHeader">
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontFamily="{StaticResource DevToolsMonospaceFont}"
                                                    FontSize="11.5"
                                                    Foreground="{ThemeResource DevToolsSyntaxPropertyBrush}"
                                                    Text="{x:Bind Name}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontFamily="{StaticResource DevToolsMonospaceFont}"
                                                    FontSize="11.5"
                                                    Text="{x:Bind Value}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <controls:CodeEditor
                                Grid.Row="1"
                                Margin="12,4,12,12"
                                CopyCommand="{x:Bind ViewModel.CopyAsCurlCommand}"
                                Header="Response body"
                                IsReadOnly="True"
                                PlaceholderText="No response body was captured."
                                ShowFooter="Collapsed"
                                Syntax="{x:Bind ViewModel.DetailResponseSyntax, Mode=OneWay}"
                                Text="{x:Bind ViewModel.DetailResponseBody, Mode=OneWay}" />
                        </Grid>

                        <!-- Timings -->
                        <ItemsControl
                            Grid.Row="2"
                            Padding="12"
                            AutomationProperties.Name="Timings"
                            ItemsSource="{x:Bind ViewModel.DetailTimings, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsTimingsView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="tools:SegmentRow">
                                    <Grid ColumnSpacing="12" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12" Text="{x:Bind Name}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontFamily="{StaticResource DevToolsMonospaceFont}"
                                            FontSize="12"
                                            Text="{x:Bind Mean}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            Grid.Row="2"
                            Margin="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Select a call to read the whole exchange."
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </controls:ToolShell>
</views:ToolPageBase>
