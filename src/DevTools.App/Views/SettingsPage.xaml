<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DevTools.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:DevTools.App.ViewModels"
    mc:Ignorable="d">

    <!--
        No MaxWidth: the cards stretch with the window, whether the navigation pane is open or
        compact, rather than sitting in a 1000 px column with empty margins either side.
    -->
    <ScrollViewer Padding="{StaticResource DevToolsPagePadding}" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="6">

            <TextBlock
                Margin="0,0,0,10"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Settings" />

            <InfoBar
                Margin="0,0,0,10"
                IsClosable="True"
                IsOpen="True"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Success"
                Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />

            <!-- ======================= Appearance ======================= -->
            <TextBlock
                Margin="0,8,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Appearance" />

            <tk:SettingsCard Description="Light, dark, or whatever Windows is using." Header="Theme">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE771;" />
                </tk:SettingsCard.HeaderIcon>
                <ComboBox
                    AutomationProperties.Name="Theme"
                    MinWidth="180"
                    SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Use system setting" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard Description="The material behind the window. Falls back to a solid colour where the system does not support it." Header="Backdrop">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </tk:SettingsCard.HeaderIcon>
                <ComboBox
                    AutomationProperties.Name="Backdrop"
                    MinWidth="180"
                    SelectedIndex="{x:Bind ViewModel.BackdropIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Mica" />
                    <ComboBoxItem Content="Mica Alt" />
                    <ComboBoxItem Content="Acrylic" />
                    <ComboBoxItem Content="None" />
                </ComboBox>
            </tk:SettingsCard>

            <!-- ======================= Editor ======================= -->
            <TextBlock
                Margin="0,16,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Editor" />

            <tk:SettingsCard Description="Applies to every input and output surface." Header="Font size">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8D2;" />
                </tk:SettingsCard.HeaderIcon>
                <StackPanel
                    MinWidth="240"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Slider
                        Width="180"
                        AutomationProperties.Name="Editor font size"
                        Maximum="{x:Bind ViewModel.MaximumFontSize}"
                        Minimum="{x:Bind ViewModel.MinimumFontSize}"
                        StepFrequency="1"
                        Value="{x:Bind ViewModel.EditorFontSize, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.EditorFontSize, Mode=OneWay}" />
                </StackPanel>
            </tk:SettingsCard>

            <tk:SettingsCard Description="Wrap long lines instead of scrolling sideways." Header="Word wrap">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7C4;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch AutomationProperties.Name="Word wrap" IsOn="{x:Bind ViewModel.WordWrap, Mode=TwoWay}" />
            </tk:SettingsCard>

            <tk:SettingsCard Description="Show a line-number gutter beside each editor." Header="Line numbers">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8FD;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch AutomationProperties.Name="Line numbers" IsOn="{x:Bind ViewModel.LineNumbers, Mode=TwoWay}" />
            </tk:SettingsCard>

            <tk:SettingsCard Description="Colour JSON, XAML and C# in the read-only result panes. Editable panes stay plain." Header="Syntax colouring">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch AutomationProperties.Name="Syntax colouring" IsOn="{x:Bind ViewModel.SyntaxColouring, Mode=TwoWay}" />
            </tk:SettingsCard>

            <!-- ======================= Behaviour ======================= -->
            <TextBlock
                Margin="0,16,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Behaviour" />

            <tk:SettingsCard Description="When DevTools gains focus, look at the clipboard and suggest matching tools. Nothing is sent anywhere." Header="Smart detect">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch AutomationProperties.Name="Smart detect" IsOn="{x:Bind ViewModel.SmartDetect, Mode=TwoWay}" />
            </tk:SettingsCard>

            <tk:SettingsCard Description="Remember each tool's options between sessions. The data you enter in a tool is always cleared when DevTools closes." Header="Remember tool state">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE81C;" />
                </tk:SettingsCard.HeaderIcon>
                <ToggleSwitch AutomationProperties.Name="Remember tool state" IsOn="{x:Bind ViewModel.PersistToolState, Mode=TwoWay}" />
            </tk:SettingsCard>

            <tk:SettingsExpander Description="Everything DevTools has stored on this machine." Header="Stored data">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </tk:SettingsExpander.HeaderIcon>
                <Button Command="{x:Bind ViewModel.OpenDataFolderCommand}" Content="Open folder" />
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="Saved tool state">
                        <Button Command="{x:Bind ViewModel.ClearToolStateCommand}" Content="Clear" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Recent tools">
                        <Button Command="{x:Bind ViewModel.ClearRecentsCommand}" Content="Clear" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Favorites">
                        <Button Command="{x:Bind ViewModel.ClearFavoritesCommand}" Content="Clear" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Description="{x:Bind ViewModel.DataFolder}" Header="Location" />
                    <tk:SettingsCard Header="All settings">
                        <Button Command="{x:Bind ViewModel.ResetAllSettingsCommand}" Content="Reset to defaults" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- ======================= Tools ======================= -->
            <TextBlock
                Margin="0,16,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Tools" />

            <tk:SettingsCard Description="Also offer the JSON Patch and Unified text result views. Side by side and Tree are always available." Header="JSON Diff Checker">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8AB;" />
                </tk:SettingsCard.HeaderIcon>
                <CheckBox
                    MinWidth="0"
                    AutomationProperties.Name="Show JSON Patch and Unified text views"
                    Content="Show text views"
                    IsChecked="{x:Bind ViewModel.JsonDiffTextViews, Mode=TwoWay}" />
            </tk:SettingsCard>

            <!-- ======================= Shortcuts ======================= -->
            <TextBlock
                Margin="0,16,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Keyboard shortcuts" />

            <tk:SettingsExpander Description="Every shortcut DevTools responds to." Header="Shortcuts" IsExpanded="False">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE765;" />
                </tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.ItemsHeader>
                    <ItemsControl Margin="16,8" ItemsSource="{x:Bind ViewModel.Shortcuts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShortcutEntry">
                                <Grid Padding="0,5" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Padding="8,2"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource DevToolsCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DevToolsCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontFamily="{StaticResource DevToolsMonospaceFont}"
                                            FontSize="12"
                                            Text="{x:Bind Keys}" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Action}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </tk:SettingsExpander.ItemsHeader>
            </tk:SettingsExpander>

            <!-- ======================= About ======================= -->
            <TextBlock
                Margin="0,16,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="About" />

            <tk:SettingsExpander Description="{x:Bind ViewModel.AppVersion}" Header="Forgekit">
                <tk:SettingsExpander.HeaderIcon>
                    <BitmapIcon ShowAsMonochrome="False" UriSource="ms-appx:///Assets/Square44x44Logo.targetsize-48.png" />
                </tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Description="{x:Bind ViewModel.Developer}" Header="Developer" />
                    <tk:SettingsCard Header="Source code">
                        <tk:SettingsCard.Description>
                            <HyperlinkButton Margin="0,0,0,0" AutomationProperties.Name="Open the GitHub repository"
                                             Content="{x:Bind ViewModel.RepositoryText}" NavigateUri="{x:Bind ViewModel.RepositoryUri}" />
                        </tk:SettingsCard.Description>
                    </tk:SettingsCard>
                    <tk:SettingsCard Description="{x:Bind ViewModel.RuntimeVersion}" Header="Runtime" />
                    <tk:SettingsCard Description="{x:Bind ViewModel.WindowsAppSdkVersion}" Header="UI framework" />
                    <tk:SettingsCard Description="{x:Bind ViewModel.OperatingSystem}" Header="Operating system" />
                    <tk:SettingsCard ContentAlignment="Vertical" Header="Privacy" HorizontalContentAlignment="Stretch">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PrivacyNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Margin="0,2" Style="{StaticResource DevToolsCaptionStyle}"
                                               Text="{x:Bind}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </tk:SettingsCard>
                    <tk:SettingsCard ContentAlignment="Vertical" Header="Open-source components" HorizontalContentAlignment="Stretch">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Licenses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Margin="0,2" Style="{StaticResource DevToolsCaptionStyle}"
                                               Text="{x:Bind}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </tk:SettingsCard>
                    <tk:SettingsCard ContentAlignment="Vertical" Header="License" HorizontalContentAlignment="Stretch">
                        <tk:SettingsCard.Description>
                            <HyperlinkButton Margin="0,0,0,0" AutomationProperties.Name="Open the License Details"
                                             Content="{x:Bind ViewModel.LicenseName}"
                                             NavigateUri="{x:Bind ViewModel.LicenseUri}" />
                        </tk:SettingsCard.Description>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <TextBlock
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource DevToolsCaptionStyle}"
                Text="{x:Bind ViewModel.Copyright}" />

        </StackPanel>
    </ScrollViewer>
</Page>
